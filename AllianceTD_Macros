j.InstallRouter = function()
	if ((type(hookmetamethod) ~= "function") or (type(getnamecallmethod) ~= "function")) then
		return false;
	end
	local router = b.__AllianceTDRouter;
	if (router and (router.Version ~= 5)) then
		router.Hub = nil;
		router = nil;
		b.__AllianceTDRouter = nil;
	end
	if router then
		router.Hub = j;
		return true;
	end
	router = {Hub = j, Version = 5};
	local original;
	local function hook(self, ...)
		local hub = router.Hub;
		if (not hub or not hub.Running) then
			return original(self, ...);
		end
		local method = getnamecallmethod();
		local isInternal = hub.Internal[coroutine.running()] or ((type(checkcaller) == "function") and checkcaller());
		local remoteName = hub.RecordRemotes and hub.RecordRemotes[self];
		local shouldRecord = ((method == "FireServer") and ((remoteName == "PlaceTower") or (remoteName == "UpgradeTower") or (remoteName == "SellTower") or (remoteName == "SetTowerTarget") or (remoteName == "ToggleDrones") or (remoteName == "UseAbility") or (remoteName == "SkipWave"))) or ((method == "InvokeServer") and (remoteName == "SkipWave"));
		if (not isInternal and shouldRecord) then
			local args = table.pack(...);
			local stamp = hub.HookStamp();
			local pre = {};
			if ((remoteName == "SellTower") and ((os.clock() - (hub.ManualSkipAt or -10)) > 0.8)) then
				shouldRecord = false;
			end
			if ((remoteName ~= "PlaceTower") and (remoteName ~= "SkipWave")) then
				local tower = ((remoteName == "UseAbility") and args[2]) or args[1];
				if ((remoteName == "UseAbility") and (args[1] ~= "Teleport") and (args[1] ~= "Drones") and (args[1] ~= "Spin")) then
					shouldRecord = false;
				end
				local cached = hub.RecordTowerCache and hub.RecordTowerCache[tower];
				if (hub.Recording and cached) then
					pre = {Handle = (cached.Handle or hub.Handle(tower)), Level = cached.Level, Cost = cached.Cost, DronesActive = cached.DronesActive};
				else
					shouldRecord = false;
				end
			end
			local results = table.pack(original(self, ...));
			if (shouldRecord and hub.Recording) then
				hub.RecordJobs = hub.RecordJobs or {};
				table.insert(hub.RecordJobs, {remoteName, args, results, pre, stamp});
			end
			return table.unpack(results, 1, results.n);
		end
		return original(self, ...);
	end
	local ok, old = pcall(hookmetamethod, game, "FireServer", ((type(newcclosure) == "function") and newcclosure(hook)) or hook);
	if not ok then return false; end
	original = old;
	b.__AllianceTDRouter = router;
	return true;
end;
j.StartRecord = function()
