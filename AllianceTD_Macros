end;
j.Claims = function()
	if (game.PlaceId ~= j.LobbyId) then return; end
	if Settings.AutoClaimQuest then
		local ok, state = j.ClaimState("Quest", "GetQuestState");
		if (ok and (type(state) == "table")) then
			for i, slot in pairs(state.Slots or {}) do
				if (not j.Running or not Settings.AutoClaimQuest) then break; end
				if (not slot.Claimed and ((slot.Progress or 0) >= (slot.Target or math.huge))) then
					j.TryClaim("Quest:" .. tostring(slot.InstanceId), "ClaimQuest", slot.Index or i, slot.InstanceId);
				end
			end
		end
	end
	if Settings.AutoClaimSeasonQuest then
		for _, entry in ipairs({{"SeasonQuest", "GetSeasonQuestState", "ClaimSeasonQuest"}, {"SeasonQuest2", "GetSeasonQuestState2", "ClaimSeasonQuest2"}}) do
			local ok, state = j.ClaimState(entry[1], entry[2]);
			if (ok and (type(state) == "table")) then
				for _, track in pairs(state.Tracks or {}) do
					for i, slot in pairs(track.Slots or {}) do
						if (not j.Running or not Settings.AutoClaimSeasonQuest) then break; end
						if (not slot.Claimed and ((slot.Progress or 0) >= (slot.Target or math.huge))) then
							j.TryClaim(entry[1] .. ":" .. tostring(slot.InstanceId), entry[3], track.Id, slot.Index or i, slot.InstanceId);
						end
					end
				end
			end
		end
	end
	if Settings.AutoClaimPass then
		local ok, state = j.ClaimState("Pass", "GetSeasonPass");
		if (ok and (type(state) == "table") and state.SeasonActive) then
			local tracks = {"Free"};
			if (state.Premium == true) then
				tracks[#tracks + 1] = "Premium";
			end
			for _, track in ipairs(tracks) do
				for tier = 1, math.min(state.Tier or 0, state.MaxTier or 50) do
					if (not j.Running or not Settings.AutoClaimPass) then break; end
					local claimed = ((track == "Premium") and state.ClaimedPremium) or state.ClaimedFree or {};
					if (not claimed[tier] and not claimed[tostring(tier)]) then
						j.TryClaim("Pass:" .. tostring(state.SeasonId) .. ":" .. track .. ":" .. tier, "ClaimPassReward", tier, track);
					end
				end
			end
		end
	end
	if Settings.AutoClaimPlaytime then
		local gui = j.PG("PlaytimeGui");
		local container = gui and gui:FindFirstChild("Gifts", true);
		local list = container and container:FindFirstChild("List", true);
		if list then
			local ready = {};
			for _, item in ipairs(list:GetChildren()) do
				local day = tonumber(item.Name:match("%d+"));
				local label = item:FindFirstChild("StatusLabel", true);
				if (day and (j.Text(label) == "Ready")) then
					ready[#ready + 1] = day;
				end
			end
			if (#ready > 0) then
				local ok2, data = j.Call("GetPlaytimeState");
				local state = ok2 and (type(data) == "table") and data.PlaytimeGifts;
				if (state and state.Day) then
					for _, day in ipairs(ready) do
						if (not j.Running or not Settings.AutoClaimPlaytime) then break; end
						j.TryClaim("Playtime:" .. tostring(state.Day) .. ":" .. day, "ClaimPlaytimeGift", day, state.Day);
					end
				end
			end
		end
	end
end;
j.HideObject = function(obj)
	if not Settings.HideName then return; end
