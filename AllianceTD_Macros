j.SetHide = function(enabled)
	for _, conn in ipairs(j.NameUIConnections or {}) do
		conn:Disconnect();
	end
	j.NameUIConnections = {};
	if not enabled then
		j.Restore(j.Hidden);
		return;
	end
	j.BindCharacter(player.Character);
	local gui = player:FindFirstChildOfClass("PlayerGui");
	local tracked = setmetatable({}, {__mode = "k"});
	local function scan(obj)
		if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("BillboardGui")) then return; end
		if (obj:IsA("BillboardGui") or tracked[obj]) then return; end
		tracked[obj] = true;
		local updating = false;
		local function refresh()
			if (updating or not Settings.HideName or not j.Running) then return; end
			local text = obj.Text;
			local function replace(str, name)
				if (name == "") then return str; end
				local escaped = name:gsub("%p", "%%%0");
				return str:gsub(escaped, "Player");
			end
			local newText = replace(replace(text, player.Name), player.DisplayName);
			if (newText ~= text) then
				j.Hidden[obj] = {Text = text};
				updating = true;
				obj.Text = newText;
				updating = false;
			elseif (text ~= "") then
				j.Hidden[obj] = nil;
			end
		end
		local conn = obj:GetPropertyChangedSignal("Text"):Connect(refresh);
		j.NameUIConnections[#j.NameUIConnections + 1] = conn;
		refresh();
	end
	local function scanTree(root)
		if not root then return; end
		j.NameUIConnections[#j.NameUIConnections + 1] = root.DescendantAdded:Connect(function(obj)
			if (j.Running and Settings.HideName) then
				pcall(scan, obj);
			end
		end);
		for _, obj in ipairs(root:GetDescendants()) do
			pcall(scan, obj);
		end
	end
	scanTree(gui);
	local ok, err = pcall(function()
		scanTree(game:GetService("CoreGui"));
	end);
	if not ok then
		j.Notify("Failed to hook CoreGui");
	end
end;
j.VisualRemoteNames = {CreateEffect = true, SpawnEffect = true, PlayEffect = true, ShowEffect = true, EmitParticles = true, CreateBeam = true, CreateTrail = true, SpawnVisual = true};
j.VisualObject = function(obj)
	if not Settings.RemoveVisuals then return; end
	if not obj:IsDescendantOf(Workspace) then return; end
	local isEffect = false;
	local cur = obj;
	while cur and (cur ~= Workspace) do
		local name = cur.Name;
		if ((name == "Effects") or (name == "Particles") or (name == "Visuals") or (name == "FX") or (name == "VFX") or (name == "Beams") or (name == "Trails")) then
			isEffect = true;
			break;
		end
		cur = cur.Parent;
	end
	local props;
	if (isEffect and obj:IsA("ParticleEmitter")) then
		props = {Enabled = false};
	elseif (isEffect and (obj:IsA("Beam") or obj:IsA("Trail"))) then
		props = {Enabled = false};
	elseif (obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")) then
		props = {Enabled = false};
	elseif obj:IsA("Decal") then
		props = {Transparency = 1};
	end
	if not props then return; end
	local saved = j.Visuals[obj] or {};
	j.Visuals[obj] = saved;
	for k, v in pairs(props) do
		pcall(function()
			if (saved[k] == nil) then
				local fps = j.FPS[obj];
				if (fps and (fps[k] ~= nil)) then
					saved[k] = fps[k];
				else
					saved[k] = obj[k];
				end
			end
			obj[k] = v;
		end);
	end
end;
j.RestoreVisuals = function()
	for obj, props in pairs(j.Visuals) do
		for k, v in pairs(props) do
			pcall(function()
				if (j.Running and Settings.FPSBoost and j.FPS[obj] and (j.FPS[obj][k] ~= nil)) then
					if (k == "Enabled") then
						obj[k] = false;
					elseif (k == "Transparency") then
						obj[k] = 1;
					else
						obj[k] = v;
					end
				else
					obj[k] = v;
				end
			end);
		end
		j.Visuals[obj] = nil;
	end
end;
j.BlockVisualEvents = function()
	if (not j.Running or not Settings.RemoveVisuals or (type(getconnections) ~= "function")) then return; end
	local folder = ReplicatedStorage:FindFirstChild("VisualRemotes");
