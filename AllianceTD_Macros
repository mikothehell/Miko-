end;
j.ClaimReady = function(key, state)
	if (key == "Pass") then
		if not state.SeasonActive then return false; end
		for tier = 1, math.min(state.Tier or 0, state.MaxTier or 50) do
			if (not (state.ClaimedFree or {})[tier] and not (state.ClaimedFree or {})[tostring(tier)]) then return true; end
			if ((state.Premium == true) and not (state.ClaimedPremium or {})[tier] and not (state.ClaimedPremium or {})[tostring(tier)]) then return true; end
		end
		return false;
	end
	local function hasReady(slots)
		for _, slot in pairs(slots or {}) do
			if (not slot.Claimed and ((slot.Progress or 0) >= (slot.Target or math.huge))) then return true; end
		end
		return false;
	end
	if (key == "Quest") then return hasReady(state.Slots); end
	for _, track in pairs(state.Tracks or {}) do
		if hasReady(track.Slots) then return true; end
	end
	return false;
end;
j.BindClaimEvents = function()
	for _, entry in ipairs({{"Quest", "GetQuestState", "AutoClaimQuest"}, {"SeasonQuest", "GetSeasonQuestState", "AutoClaimSeasonQuest"}, {"Playtime", "GetPlaytimeGifts", "AutoClaimPlaytime"}, {"Pass", "GetSeasonPass", "AutoClaimPass"}}) do
		local key, remoteName, settingKey = entry[1], entry[2], entry[3];
		local r = j.Remote(remoteName);
		if (r and not j.Bound[r]) then
			j.Bound[r] = true;
			j.Connect(r.OnClientEvent, function(state)
				if (type(state) ~= "table") then return; end
				j.ClaimStates = j.ClaimStates or {};
				j.ClaimStates[key] = {State = state, At = os.clock()};
				if (Settings[settingKey] and j.ClaimReady(key, state)) then
					j.WakeClaims();
				end
			end);
		end
	end
	local gui = j.PG("PlaytimeGui");
	local container = gui and gui:FindFirstChild("Gifts", true);
	local list = container and container:FindFirstChild("List", true);
	if list then
		for _, item in ipairs(list:GetChildren()) do
			local label = item:FindFirstChild("StatusLabel", true);
			if (label and not j.Bound[label]) then
				j.Bound[label] = true;
				j.Connect(label:GetPropertyChangedSignal("Text"), function()
					if (Settings.AutoClaimPlaytime and (j.Text(label) == "Ready")) then
						j.WakeClaims();
					end
