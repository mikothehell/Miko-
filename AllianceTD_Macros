			if (j.Running and ok and res) then
				j.UpdateBoosts(state);
			end
		end);
	end
	if (not j.Running or not Settings.AutoUsePotion or (game.PlaceId ~= j.LobbyId)) then return; end
	local inv = j.BoostState and j.BoostState.Inventory;
	if not inv then return; end
	local available = {};
	for key in pairs(j.PotionNames) do
		if (Settings.SelectedPotions[key] and ((tonumber(inv[key]) or 0) > 0)) then
			available[#available + 1] = key;
		end
	end
	table.sort(available);
	if ((#available == 0) or ((j.PotionPending or 0) >= 8)) then return; end
	local idx = 1;
	for i, key in ipairs(available) do
		if (key == j.LastPotion) then
			idx = (i % #available) + 1;
			break;
		end
	end
	local key = available[idx];
	j.LastPotion = key;
	j.PotionPending = (j.PotionPending or 0) + 1;
	task.spawn(function()
		if (not j.Running or not Settings.AutoUsePotion or not Settings.SelectedPotions[key] or (game.PlaceId ~= j.LobbyId)) then
			j.PotionPending = j.PotionPending - 1;
			return;
		end
		local ok, res, success, data = pcall(j.Call, "UsePotion", key);
		j.PotionPending = j.PotionPending - 1;
		if not j.Running then return; end
		if (ok and res and (success == true) and (type(data) == "table") and (type(data.Inventory) == "table")) then
			local inv2 = j.BoostState and j.BoostState.Inventory;
			if inv2 then
				for k, v in pairs(data.Inventory) do
					if (type(v) == "number") then
						inv2[k] = math.min(tonumber(inv2[k]) or v, v);
					end
				end
			end
		end
	end);
end;
j.SellAllStep = function()
	if (not j.Running or not Settings.AutoSellAllOnWave or (game.PlaceId ~= j.MatchId) or j.Ended or (j.Wave <= 0) or j.AutoSelling) then return; end
	local wave = j.Wave;
	local should = false;
	for waveStr in tostring(Settings.SellAllWaves):gmatch("%d+") do
		if (tonumber(waveStr) == wave) then
			should = true;
			break;
		end
	end
	if not should then return; end
	j.SellAllDone = j.SellAllDone or {};
	if j.SellAllDone[wave] then return; end
	j.SellAllDone[wave] = true;
	j.AutoSelling = true;
	local round = j.SellRound or 0;
	local towers = j.Towers();
	local batch = {Pending = 0, Dispatching = true};
	j.SellBatch = batch;
	local function check()
		if (not batch.Dispatching and (batch.Pending == 0) and (j.SellBatch == batch)) then
			j.AutoSelling = false;
			j.SellBatch = nil;
		end
	end
	task.spawn(function()
		local ok, err = pcall(function()
			for _, tower in ipairs(towers) do
				if (not j.Running or not Settings.AutoSellAllOnWave or j.Ended or (game.PlaceId ~= j.MatchId) or ((j.SellRound or 0) ~= round)) then break; end
				if (tower.Parent and j.Own(tower)) then
					local t = tower;
					batch.Pending = batch.Pending + 1;
					task.spawn(function()
						if (j.Running and Settings.AutoSellAllOnWave and not j.Ended and (game.PlaceId == j.MatchId) and ((j.SellRound or 0) == round) and t.Parent and j.Own(t)) then
							pcall(j.Call, "SellTower", t);
						end
						batch.Pending = batch.Pending - 1;
						check();
					end);
				end
			end
		end);
		batch.Dispatching = false;
		check();
		if not ok then
			warn("SellAll error: " .. tostring(err));
		end
	end);
end;
j.SpinWheelStep = function()
	if (not j.Running or not Settings.AutoSpinWheel or (game.PlaceId ~= j.LobbyId) or not j.Due("SpinWheel", 0.1)) then return; end
	local state = j.SpinState;
	if (not state or (os.clock() >= (j.SpinReadAt or 0))) then
		local ok, res = j.Call("GetSpinState");
		if (not ok or (type(res) ~= "table")) then
			j.Next.SpinWheel = os.clock() + 0.1;
			return;
		end
		j.SpinState = res;
		state = res;
		j.SpinReadAt = os.clock() + 5;
	end
	if (not j.Running or not Settings.AutoSpinWheel or (game.PlaceId ~= j.LobbyId)) then return; end
	if state.InventoryFull then
		j.Next.SpinWheel = os.clock() + 0.1;
		return;
	end
	local freeSpins = tonumber(state.FreeSpins) or 0;
	local tickets = tonumber(state.Tickets) or 0;
	local cost = tonumber(state.Cost) or 1;
	if ((freeSpins <= 0) and (tickets < cost)) then
		j.Next.SpinWheel = os.clock() + 0.1;
		return;
	end
	if ((j.SpinPending or 0) >= 8) then return; end
	j.SpinPending = (j.SpinPending or 0) + 1;
	task.spawn(function()
		if (not j.Running or not Settings.AutoSpinWheel or (game.PlaceId ~= j.LobbyId)) then
			j.SpinPending = j.SpinPending - 1;
			return;
		end
		local ok, res, data = pcall(j.Call, "SpinWheel");
		j.SpinPending = j.SpinPending - 1;
		if not j.Running then return; end
		if (ok and res and (type(data) == "table") and (data.Success == true)) then
			local st = j.SpinState;
			if st then
				if tonumber(data.FreeSpins) then
					st.FreeSpins = math.min(tonumber(st.FreeSpins) or 0, data.FreeSpins);
				end
				if tonumber(data.Tickets) then
					st.Tickets = math.min(tonumber(st.Tickets) or 0, data.Tickets);
				end
			end
		else
			j.SpinState = nil;
			j.Next.SpinWheel = os.clock() + 0.1;
		end
	end);
end;
