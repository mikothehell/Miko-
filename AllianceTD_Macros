j.ResolveExisting = function()
	j.Handles = {};
	local used = {};
	for _, entry in ipairs(j.Existing) do
		local target = CFrame.new(table.unpack(entry.CFrame));
		local best, bestDist = nil, 1;
		for _, tower in ipairs(j.Towers()) do
			if (not used[tower] and ((tower:GetAttribute("UnitName") or tower.Name) == entry.Unit)) then
				local dist = (tower:GetPivot().Position - target.Position).Magnitude;
				if (dist < bestDist) then
					best, bestDist = tower, dist;
				end
			end
		end
		if not best then
			return false, "Missing tower: " .. entry.Unit;
		end
		used[best] = true;
		j.Handles[entry.Handle] = best;
	end
	return true;
end;
