j.UpdateCrates = function(inv, authoritative)
	if (type(inv) ~= "table") then return; end
	local crates = {};
	local names = {};
	for k, v in pairs(inv) do
		if ((type(k) == "string") and (type(v) == "number") and (v > 0)) then
			crates[k] = math.floor(v);
			names[#names + 1] = k;
		end
	end
	table.sort(names);
	j.Crates = crates;
	if authoritative then j.CratesAuthoritative = true; end
	local key = table.concat(names, "\0");
	if (j.Widgets.OpenCrates and (key ~= j.CrateOptionsKey)) then
		j.RefreshingCrates = true;
		local selected = {};
		for _, name in ipairs(names) do
			if Settings.OpenCrates[name] then selected[#selected + 1] = name; end
		end
		local ok, err = pcall(function()
			j.Widgets.OpenCrates:Refresh(names);
			j.Widgets.OpenCrates:Select(selected);
		end);
		j.RefreshingCrates = false;
		if ok then
			j.CrateOptionsKey = key;
		else
			warn("Crate refresh failed: " .. tostring(err));
		end
	end
	return names;
end;
