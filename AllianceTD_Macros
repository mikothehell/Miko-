	end
	if not j.InstallRouter() then
		j.Notify("Failed to install hook");
		return;
	end
	j.Actions, j.Existing, j.RecordHandles, j.RecordJobs = {}, {}, {}, {};
	j.HandleCount = 0;
	j.RecordEpoch = j.RecordEpoch + 1;
	j.ProfileMap = j.MapId();
	j.RecordStart = j.GameTime;
	for _, tower in ipairs(j.Towers()) do
		j.Existing[#j.Existing + 1] = {Handle = j.Handle(tower), Unit = (tower:GetAttribute("UnitName") or tower.Name), CFrame = {tower:GetPivot():GetComponents()}};
	end
	j.Recording = true;
