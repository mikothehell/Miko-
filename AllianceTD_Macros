j.ConnectionError = function(err)
	if (type(err) ~= "string") then return false; end
	local lower = err:lower();
	return (lower:match("lost connection") ~= nil) or (lower:find("connection lost", 1, true) ~= nil) or (lower:find("disconnected", 1, true) ~= nil) or (lower:find("reconnect", 1, true) ~= nil) or (lower:find("failed to connect", 1, true) ~= nil) or (lower:find("server closed", 1, true) ~= nil) or (lower:find("kick", 1, true) ~= nil);
