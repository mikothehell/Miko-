j.WakeClaims = function()
	j.ClaimsWake = true;
end;
j.ClaimState = function(key, remoteName)
	j.ClaimStates = j.ClaimStates or {};
	local cached = j.ClaimStates[key];
	if (cached and ((os.clock() - cached.At) < 5)) then
		return true, cached.State;
	end
	local ok, state = j.Call(remoteName);
