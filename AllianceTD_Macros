j.TryClaim = function(key, remoteName, ...)
	j.ClaimAttempts = j.ClaimAttempts or {};
	if (os.clock() < (j.ClaimAttempts[key] or -1)) then return; end
	j.ClaimAttempts[key] = os.clock() + 5;
	local ok, res = j.Call(remoteName, ...);
	if (ok and ((res == true) or ((type(res) == "table") and (res.Success == true)))) then
		j.ClaimAttempts[key] = math.huge;
