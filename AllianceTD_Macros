j.SetRemoveVisuals = function(enabled)
	j.VisualGeneration = (j.VisualGeneration or 0) + 1;
	local gen = j.VisualGeneration;
	for _, conn in ipairs(j.VisualConnections) do
		pcall(function() conn:Disconnect(); end);
	end
	j.VisualConnections = {};
	for conn in pairs(j.BlockedVisualCallbacks or {}) do
		pcall(function() conn:Enable(); end);
	end
	j.BlockedVisualCallbacks = {};
	j.RestoreVisuals();
	if not enabled then return; end
	if (type(getconnections) ~= "function") then
		j.Notify("Remove Visuals requires getconnections support");
	end
	j.BlockVisualEvents();
	local queue, tracked, running = {}, setmetatable({}, {__mode = "k"}), false;
	local function enqueue(obj)
		if tracked[obj] then return; end
		tracked[obj] = true;
		queue[#queue + 1] = obj;
		if running then return; end
		running = true;
		task.defer(function()
			local idx, last = 1, os.clock();
			while j.Running and Settings.RemoveVisuals and (gen == j.VisualGeneration) and (idx <= #queue) do
				local obj2 = queue[idx];
				queue[idx] = false;
				idx = idx + 1;
				tracked[obj2] = nil;
				j.VisualObject(obj2);
				if ((os.clock() - last) >= 0.002) then
					task.wait();
					last = os.clock();
				end
			end
			queue = {};
			running = false;
		end);
	end
	local roots = {Workspace};
	for _, root in ipairs(roots) do
		j.VisualConnections[#j.VisualConnections + 1] = root.DescendantAdded:Connect(enqueue);
	end
	task.spawn(function()
		local last = os.clock();
		for _, root in ipairs(roots) do
			for _, obj in ipairs(root:GetDescendants()) do
				if (not j.Running or not Settings.RemoveVisuals or (gen ~= j.VisualGeneration)) then return; end
				j.VisualObject(obj);
				if ((os.clock() - last) >= 0.002) then
					task.wait();
					last = os.clock();
				end
			end
		end
	end);
end;
j.FPSObject = function(obj)
	if (not Settings.FPSBoost or j.FPS[obj]) then return; end
	local props;
	if obj:IsA("BasePart") then
		props = {CastShadow = false, Material = Enum.Material.SmoothPlastic, Reflectance = 0};
	elseif (obj:IsA("ParticleEmitter") or obj:IsA("Beam")) then
		props = {Enabled = false};
	elseif (obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion")) then
		props = {Transparency = 1};
	elseif obj:IsA("PointLight") then
		props = {Enabled = false};
	elseif obj:IsA("Atmosphere") then
		props = {Density = 0, Haze = 0, Glare = 0};
	elseif obj:IsA("Sky") then
		props = {StarCount = 0};
	end
	if props then
		j.FPSProperties(obj, props);
	end
end;
j.FPSProperties = function(obj, props)
	local saved = j.FPS[obj] or {};
	j.FPS[obj] = saved;
	for k, v in pairs(props) do
		pcall(function()
			if (saved[k] == nil) then
				local vis = j.Visuals[obj];
				if (vis and (vis[k] ~= nil)) then
					saved[k] = vis[k];
				else
					saved[k] = obj[k];
				end
			end
			obj[k] = v;
		end);
	end
end;
j.QueueFPS = function(obj)
	if not Settings.FPSBoost then return; end
	j.FPSPending = j.FPSPending or {};
	j.FPSPending[#j.FPSPending + 1] = obj;
	if j.FPSWorker then return; end
	j.FPSWorker = true;
	task.defer(function()
		local idx = 1;
		local last = os.clock();
		while j.Running and Settings.FPSBoost and (idx <= #j.FPSPending) do
			local obj2 = j.FPSPending[idx];
			idx = idx + 1;
			if obj2.Parent then
				j.FPSObject(obj2);
			end
			if ((os.clock() - last) >= 0.002) then
				task.wait();
				last = os.clock();
			end
		end
		j.FPSPending = {};
		j.FPSWorker = false;
	end);
end;
j.SetFPS = function(enabled)
