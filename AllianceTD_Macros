	end, 3.5);
	for _, job in ipairs(j.RecordJobs or {}) do
		j.RecordCall(table.unpack(job));
	end
	j.RecordJobs = {};
	j.Recording = false;
	j.RecordEpoch = j.RecordEpoch + 1;
	j.SaveMacro();
	j.Status = "Recording stopped";
	if j.Widgets.Record then
		j.ChangingToggle = true;
		pcall(function()
