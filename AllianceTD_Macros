		if j.Own(tower) then
			j.RecordTowerCache[tower] = {Handle = ((j.Recording and j.Handle(tower)) or nil), Level = (tower:GetAttribute("Level") or 1), Cost = (tower:GetAttribute("Cost") or 0), DronesActive = (tower:GetAttribute("DronesActive") == true)};
		else
			j.RecordTowerCache[tower] = nil;
		end
	end
	refresh();
	if not j.Bound[tower] then
		j.Bound[tower] = true;
		for _, attr in ipairs({"Level", "Cost", "DronesActive", "OwnerId"}) do
			j.Connect(tower:GetAttributeChangedSignal(attr), refresh);
		end
	end
end;
