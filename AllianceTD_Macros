	end
	local lighting = game:GetService("Lighting");
	j.FPSProperties(lighting, {GlobalShadows = false, Brightness = 0, Ambient = Color3.new(0,0,0), EnvironmentDiffuseScale = 0.5});
	local atmosphere = Workspace:FindFirstChildOfClass("Atmosphere");
	if atmosphere then
		j.FPSProperties(atmosphere, {Density = 0, Haze = 0, Glare = 0, EnvironmentDiffuseScale = 0.5});
	end
