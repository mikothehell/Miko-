j.RecordCall = function(remoteName, args, results, pre, stamp)
	if (not j.Recording or (stamp.Epoch ~= j.RecordEpoch)) then return; end
	if (remoteName == "PlaceTower") then
		local tower = args[1];
		if not j.Own(tower) then return; end
		j.Append({Kind = "Place", Handle = j.Handle(tower), Unit = (tower:GetAttribute("UnitName") or args[1]), CFrame = {results[2]:GetComponents()}, Level = (tower:GetAttribute("Level") or 1), Cost = (tower:GetAttribute("Cost") or math.max(0, stamp.Cash - j.Cash()))}, stamp);
	elseif (remoteName == "UpgradeTower") then
		local tower = args[1];
		if (not j.Own(tower) or (results[1] ~= true)) then return; end
		j.WaitFor(function()
			return not tower.Parent or ((tower:GetAttribute("Level") or 0) > pre.Level);
		end, 3);
		local newLevel = tower:GetAttribute("Level");
		if (newLevel and (newLevel > pre.Level)) then
			j.Append({Kind = "Upgrade", Handle = pre.Handle, Level = newLevel, Cost = pre.Cost}, stamp);
		end
	elseif ((remoteName == "SellTower") and (results[1] == true)) then
		j.Append({Kind = "Sell", Handle = pre.Handle, Cost = 0}, stamp);
	elseif ((remoteName == "SetTowerTarget") and (results[1] == true)) then
		j.Append({Kind = "Target", Handle = pre.Handle, Target = args[2], Cost = 0}, stamp);
	elseif ((remoteName == "ToggleDrones") and (results[1] == true) and j.Own(args[1])) then
		j.Append({Kind = "Toggle", Handle = pre.Handle, Cost = 0}, stamp);
	elseif ((remoteName == "UseAbility") and (results[1] == true) and j.Own(args[2])) then
		local ability = args[1];
		if ((ability == "Teleport") and (typeof(args[3]) == "CFrame")) then
			j.Append({Kind = "Teleport", SubType = "Position", Handle = pre.Handle, CFrame = {args[3]:GetComponents()}, Cost = 0}, stamp);
		elseif (ability == "Drones") then
			j.Append({Kind = "Ability", SubType = "Drones", Handle = pre.Handle, Enabled = not pre.DronesActive, Cost = 0}, stamp);
		elseif (ability == "Spin") then
			j.Append({Kind = "Ability", SubType = "Spin", Handle = pre.Handle, Cost = 0}, stamp);
		end
	elseif (remoteName == "SkipWave") then
		j.Append({Kind = "Skip", WaveToken = tonumber(args[1]), Cost = 0}, stamp);
	end
end;
j.BindRecordTower = function(tower)
