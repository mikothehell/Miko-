	elseif ((obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj:FindFirstAncestorWhichIsA("PlayerGui") and (obj.Text:find(player.Name, 1, true) or ((player.DisplayName ~= "") and obj.Text:find(player.DisplayName, 1, true)))) then
		if not j.Hidden[obj] then
