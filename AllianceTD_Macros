j.Rejoin = function()
	local r = j.Reconnect;
	if (not j.Running or not r or r.InFlight) then return; end
	r.Attempts = r.Attempts + 1;
	r.InFlight = os.clock();
	r.NextAt = os.clock() + (({10, 20})[r.Attempts] or 60);
	j.SaveConfig(true);
	j.QueueTeleport();
	local ok = pcall(TeleportService.Teleport, TeleportService, j.LobbyId, player);
	if not ok then
		r.InFlight = nil;
	end
end;
j.RejoinStep = function(err)
	if not j.Running then return; end
	local r = j.Reconnect;
	local now = os.clock();
	if r.InFlight then
		if ((now - r.InFlight) < 45) then return; end
		r.InFlight = nil;
	end
	if not j.ConnectionError(err) then
		r.Prompt = nil;
		r.Attempts = 0;
		r.NextAt = nil;
		return;
	end
	if not r.Prompt then
		r.Prompt = err;
		r.Attempts = 0;
		r.NextAt = now + 3;
	end
	if (now >= (r.NextAt or 0)) then
		j.Rejoin();
	end
end;
