j.CrateStep = function()
	if ((game.PlaceId ~= j.LobbyId) or not j.Running) then return; end
	if j.Due("SeedCrates", 2) then
		j.SeedCrates();
	end
	local amounts = {One = 1, Three = 3, Ten = 10};
	if (Settings.AutoBuyCrate and j.Due("BuyCrate", Settings.BuyCrateDelay)) then
		local amount = amounts[Settings.BuyCrateAmount] or 1;
		local ok, res, err;
		if (Settings.BuyCrate == "Basic") then
			ok, res, err = j.Call("BuyCrate", amount);
		elseif (Settings.BuyCrate == "Premium") then
			ok, res, err = j.Call("BuyPremiumCrate", Settings.BuyCrate, amount);
		else
			j.Next.BuyCrate = os.clock() + 5;
			return;
		end
		local delay = (ok and (res == true) and Settings.BuyCrateDelay) or math.max(5, Settings.BuyCrateDelay);
		j.Next.BuyCrate = os.clock() + delay;
	end
	if (Settings.AutoOpenCrate and j.Due("OpenCrate", Settings.OpenCrateDelay)) then
		local available = {};
		for name, count in pairs(j.Crates or {}) do
			if ((count > 0) and Settings.OpenCrates[name]) then
				available[#available + 1] = name;
			end
		end
		table.sort(available);
		local idx = 1;
		for i, name in ipairs(available) do
			if (name == j.LastOpenedCrate) then
				idx = (i % #available) + 1;
				break;
			end
		end
		local name = available[idx];
		if name then
			local count = math.min(({One = 1, Three = 3, Six = 6})[Settings.OpenCrateAmount] or 1, j.Crates[name]);
			j.LastOpenedCrate = name;
			local ok, res, data = j.Call("OpenCrate", name, count);
			if (ok and (res == true) and (type(data) == "table") and (type(data.Inventory) == "table")) then
				j.UpdateCrates(data.Inventory, true);
			end
			j.Next.OpenCrate = os.clock() + ((ok and (res == true) and Settings.OpenCrateDelay) or math.max(5, Settings.OpenCrateDelay));
		end
	end
end;
j.SyncSummonSell = function()
