local FakeName = "GAY OWNER GAME" -- Thay đổi tên giả mong muốn tại đây

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Hàm cập nhật tên hiển thị trên nhân vật và giao diện local
local function applyFakeName(character)
    if not character then return end

    -- Cập nhật thuộc tính DisplayName của Player
    pcall(function()
        LocalPlayer.DisplayName = FakeName
    end)

    -- Tìm và ghi đè TextLabel trong BillboardGui trên đầu nhân vật (Overhead UI)
    local head = character:WaitForChild("Head", 5)
    if head then
        for _, gui in ipairs(head:GetChildren()) do
            if gui:IsA("BillboardGui") then
                for _, element in ipairs(gui:GetDescendants()) do
                    if element:IsA("TextLabel") then
                        element.Text = FakeName
                    end
                end
            end
        end
    end
end

-- 1. Xử lý duy trì khi nhân vật hồi sinh (Xóa/Chết không mất)
if LocalPlayer.Character then
    task.spawn(applyFakeName, LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    newCharacter:WaitForChild("Humanoid")
    task.wait(0.5) -- Chờ UI nhân vật khởi tạo hoàn tất
    applyFakeName(newCharacter)
end)

-- 2. Xử lý duy trì khi chuyển Server (Server Hop persistence)
local queueTeleport = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
if queueTeleport then
    -- Tự động thực thi lại script sau khi chuyển sang server mới
    queueTeleport(string.format([[
        repeat task.wait() until game:IsLoaded()
        local FakeName = "%s"
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        
        LocalPlayer.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            pcall(function() LocalPlayer.DisplayName = FakeName end)
        end)
    ]], FakeName))
end
