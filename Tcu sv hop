local function getRootPart()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return char.HumanoidRootPart
        end
    end
    return nil
end

local function stopVelocity(root)
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function HopServer()
    if isHopping then return end
    isHopping = true
    WindUI:Notify({ Title = "Server Hop", Content = "Không còn Item! Đang lưu script & chuyển Server...", Duration = 3 })
    
    -- Lưu script vào bộ nhớ Teleport trước khi nhảy sang server khác
    SaveScriptForTeleport()

    pcall(function()
        local ApiUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local rawData = game:HttpGet(ApiUrl)
        local servers = HttpService:JSONDecode(rawData).data
        
        for _, s in ipairs(servers) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                task.wait(5)
                break
            end
        end
    end)
    isHopping = false
end

