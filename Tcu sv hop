local function isPlayerCharacter(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        local pChar = p.Character
        if pChar and (obj == pChar or obj:IsDescendantOf(pChar)) then
            return true
        end
    end
    return false
end

-- ====================================================
-- ITEM FARMING LOGIC
-- ====================================================
local function isValidItem(obj, prompt)
    if not obj or not obj.Parent then return false end
    if isPlayerCharacter(obj) then return false end

    if obj:IsA("Seat") or obj:IsA("VehicleSeat") or obj:FindFirstChildOfClass("Seat") or obj:FindFirstChildOfClass("VehicleSeat") then
        return false
    end

    local model = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
    if model and not model:IsA("Tool") then
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum then return false end
    end

    if prompt then
        local actionText = string.lower(prompt.ActionText or "")
        local objectText = string.lower(prompt.ObjectText or "")
        local badWords = {"revive", "cứu", "help", "heal", "carry", "rescue", "drive", "ride", "enter", "vehicle", "shop", "buy", "talk"}
        for _, badWord in ipairs(badWords) do
            if string.find(actionText, badWord) or string.find(objectText, badWord) then
                return false
            end
        end
    end

    return true
end

local function getMapItems()
    local items = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and isValidItem(parent, obj) then
                table.insert(items, { Type = "Prompt", Target = parent, Prompt = obj })
            end
        elseif obj:IsA("TouchTransmitter") then
            local part = obj.Parent
            if part and part:IsA("BasePart") and isValidItem(part, nil) then
                table.insert(items, { Type = "Touch", Target = part, Part = part })
            end
        elseif obj:IsA("Tool") and obj.Parent == Workspace then
            if isValidItem(obj, nil) then
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    table.insert(items, { Type = "Tool", Target = obj, Part = handle })
                end
            end
        end
    end
    return items
end

local function triggerPickup(char, itemData)
    if not char or not itemData or not itemData.Target or not itemData.Target.Parent then return end

    if itemData.Prompt then
        local prompt = itemData.Prompt
        if prompt and prompt.Parent then
            pcall(function()
                prompt.HoldDuration = 0
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 9999
                prompt.Enabled = true
                if fireproximityprompt then
                    fireproximityprompt(prompt, 0)
                    task.wait(0.01)
                    fireproximityprompt(prompt, 1)
                end
            end)
        end
    end

    local targetPart = itemData.Part or (itemData.Target:IsA("BasePart") and itemData.Target or itemData.Target:FindFirstChildWhichIsA("BasePart", true))
    if targetPart and firetouchinterest then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(part, targetPart, 0)
                    task.wait(0.01)
                    firetouchinterest(part, targetPart, 1)
                end)
            end
        end
    end
end

-- ====================================================
-- MOB FARMING LOGIC
-- ====================================================
local function isEnemyMob(model)
    if not model or not model:IsA("Model") then return false end
    if model == LocalPlayer.Character or isPlayerCharacter(model) then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
    if not root then return false end

    local nameLower = string.lower(model.Name)
    local ignoreKeywords = {"npc", "shop", "display", "lobby", "store", "spawn", "building"}
    for _, kw in ipairs(ignoreKeywords) do
        if string.find(nameLower, kw) then
            return false
        end
    end

    return true
end

local function getNearestEnemy()
    local root = getRootPart()
    if not root then return nil end

    local nearest = nil
    local shortestDist = math.huge

    local function scanContainer(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Model") and isEnemyMob(obj) then
                local enemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj.PrimaryPart
                if enemyRoot then
                    local dist = (root.Position - enemyRoot.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearest = enemyRoot
                    end
                end
            elseif obj:IsA("Folder") or (obj:IsA("Model") and not isEnemyMob(obj)) then
                scanContainer(obj)
            end
        end
    end

    scanContainer(Workspace)
    return nearest
end

