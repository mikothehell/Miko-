-- 5. Auto Farm Mob Loop
task.spawn(function()
    while true do
        task.wait(0.05)
        if AutoFarmMobEnabled and not AutoFarmEnabled then
            pcall(function()
                local root = getRootPart()
                local isAlive = currentMobTarget and currentMobTarget.Parent 
                    and currentMobTarget.Parent:FindFirstChildOfClass("Humanoid") 
                    and currentMobTarget.Parent:FindFirstChildOfClass("Humanoid").Health > 0

                if not isAlive then
                    currentMobTarget = getNearestEnemy()
                end

                if root and currentMobTarget then
                    root.CFrame = currentMobTarget.CFrame * CFrame.new(0, 5, 0)
                    stopVelocity(root)

                    if AutoAttackMob then
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        task.wait(0.01)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end
                end
            end)
        end
    end
end)

-- 6. Auto Farm Item Loop
task.spawn(function()
    task.wait(3) -- Đợi 3 giây cho Map load xong
    while true do
        task.wait(ScanDelay)
        if AutoFarmEnabled then
            local char = LocalPlayer.Character
            local root = getRootPart()

            if root and char then
                if ReturnToOldPos and not savedPosition then
                    savedPosition = root.CFrame
                end

                local items = getMapItems()
                if #items > 0 then
                    for _, itemData in ipairs(items) do
                        if not AutoFarmEnabled then break end

                        local target = itemData.Target
                        if target and target.Parent then
                            local targetCFrame = nil
                            if itemData.Part then
                                targetCFrame = itemData.Part.CFrame
                            elseif target:IsA("BasePart") then
                                targetCFrame = target.CFrame
                            elseif target:IsA("Model") or target:IsA("Tool") then
                                targetCFrame = target:GetPivot()
                            end

                            if targetCFrame then
                                pcall(function()
                                    root.Anchored = false
                                    root.CFrame = targetCFrame * CFrame.new(0, 0.5, 0)
                                    stopVelocity(root)
                                    task.wait(0.05)

                                    for i = 1, 3 do
                                        if not target or not target.Parent then break end
                                        triggerPickup(char, itemData)
                                        task.wait(0.04)
                                    end

                                    task.wait(PickupDelay)
                                end)
                            end
                        end
                    end

                    local remainingItems = getMapItems()
                    if #remainingItems == 0 and AutoServerHopItem then
                        HopServer()
                    end
                else
                    if AutoServerHopItem then
                        HopServer()
                    elseif root and savedPosition and ReturnToOldPos then
                        root.Anchored = false
                        root.CFrame = savedPosition
                        stopVelocity(root)
                    end
                end
            end
        end
    end
end)
