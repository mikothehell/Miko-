local function calculateFarmCFrame(enemyHrp)
    local pos = _G.FarmPosition
    local dist = _G.FarmDistance
    if pos == "Above" then
        return enemyHrp.CFrame * CFrame.new(0, dist, 0) * CFrame.Angles(math.rad(-90), 0, 0)
    elseif pos == "Underground" then
        return enemyHrp.CFrame * CFrame.new(0, -dist, 0) * CFrame.Angles(math.rad(90), 0, 0)
    elseif pos == "Behind" then
        return enemyHrp.CFrame * CFrame.new(0, 0, dist)
    elseif pos == "In Front" then
        return enemyHrp.CFrame * CFrame.new(0, 0, -dist) * CFrame.Angles(0, math.rad(180), 0)
    end
    return enemyHrp.CFrame * CFrame.new(0, -dist, 0)
end

-- NEAREST TOILET FINDER
local function getNearestToilet()
    local closest = nil
    local shortestDist = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Humanoid") and v.Parent and isValidToilet(v.Parent) then
            local mob = v.Parent
            local hrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head") or mob:FindFirstChild("Torso") or mob.PrimaryPart
            if hrp then
                local dist = (myPos - hrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = mob
                end
            end
        end
    end
    return closest
end

