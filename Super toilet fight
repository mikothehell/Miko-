local function executeSmartCombat(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if _G.AutoSkill and not isExecutingSkills then
        local currentTime = tick()
        if currentTime - lastSkillUsedTime >= _G.SkillDelay then
            lastSkillUsedTime = currentTime
            isExecutingSkills = true
            task.spawn(function()
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                local tools = {}
                if backpack then
                    for _, item in pairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then
                            table.insert(tools, item)
                        end
                    end
                end
                for i = 1, 10 do
                    if not _G.AutoSkill or not _G.AutoFarm then break end
                    if _G.SelectedSkills[i] then
                        local key = skillKeyCodes[i]
                        if key then
                            VirtualInputManager:SendKeyEvent(true, key, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, key, false, game)
                        end
                        if tools[i] and tools[i].Parent == backpack then
                            pcall(function()
                                hum:EquipTool(tools[i])
                                task.wait(0.02)
                                tools[i]:Activate()
                            end)
                        end
                        task.wait(0.02)
                    end
                end
                isExecutingSkills = false
            end)
        end
    end
    if _G.AutoLetterKeys then
        task.spawn(function()
            for keyChar, isEnabled in pairs(_G.SelectedLetterKeys) do
                if isEnabled and Enum.KeyCode[keyChar] then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[keyChar], false, game)
                    task.wait(0.015)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[keyChar], false, game)
                end
            end
        end)
    end
    if _G.AutoPunch then
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

