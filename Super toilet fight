-- ANTI-VOID SAFE TELEPORT FUNCTION
local function safeTeleportAndTrigger(targetCFrame, targetPart, promptObj)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = targetCFrame
    
    hrp.Anchored = true

    if targetPart then
        firetouchinterest(hrp, targetPart, 0)
        task.wait(0.01)
        firetouchinterest(hrp, targetPart, 1)
    end

    if promptObj then
        fireproximityprompt(promptObj)
    end

    task.wait(0.2)
    hrp.Anchored = false
end

-- ACCURATE AUTO TELEPORT & TRIGGER ENGINE
local function triggerTargetSelection(targetName)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local targetStr = string.lower(targetName)
    local found = false

    -- 1. Scan ProximityPrompt
    for _, prompt in pairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local promptText = string.lower(prompt.ObjectText .. " " .. prompt.ActionText .. " " .. prompt.Name)
            local parentName = prompt.Parent and string.lower(prompt.Parent.Name) or ""
            
            if string.find(promptText, targetStr) or string.find(parentName, targetStr) then
                found = true
                local parentPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildOfClass("BasePart")
                if parentPart then
                    safeTeleportAndTrigger(parentPart.CFrame * CFrame.new(0, 3, 0), parentPart, prompt)
                else
                    fireproximityprompt(prompt)
                end
                break
            end
        end
    end
    
    -- 2. Scan Pad / Platform Parts
    if not found then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local objName = string.lower(obj.Name)
                local parentName = obj.Parent and string.lower(obj.Parent.Name) or ""
                
                if string.find(objName, targetStr) or string.find(parentName, targetStr) then
                    local padPart = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart"))
                    if padPart then
                        local prompt = padPart:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ProximityPrompt")
                        safeTeleportAndTrigger(padPart.CFrame * CFrame.new(0, 2.5, 0), padPart, prompt)
                        found = true
                        break
                    end
                end
            end
        end
    end

    -- 3. Direct Remote Fallback
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            local rName = string.lower(remote.Name)
            if string.find(rName, "select") or string.find(rName, "mode") or string.find(rName, "map") or string.find(rName, "join") or string.find(rName, "teleport") then
                pcall(function()
                    if remote:IsA("RemoteEvent") then
                        remote:FireServer(targetName)
                    else
                        remote:InvokeServer(targetName)
                    end
                end)
            end
        end
    end
end

