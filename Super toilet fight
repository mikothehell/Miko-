-- STRICT & ACCURATE TOILET TARGET FINDER (FIXED NPC & LOBBY TARGET BUG)
local function isValidToilet(mob)
    if not mob or not mob:IsA("Model") then return false end
    
    local char = LocalPlayer.Character
    if char and (mob == char or mob:IsDescendantOf(char)) then return false end
    if Players:GetPlayerFromCharacter(mob) then return false end
    
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    
    local mobName = string.lower(mob.Name)
    local parentName = mob.Parent and string.lower(mob.Parent.Name) or ""
    
    -- Danh sách các từ khóa NPC / Sảnh / Leaderboard cần BỎ QUA
    local blacklist = {
        "dummy", "shop", "roblox", "lobby", "safe", "leaderboard", 
        "cameraman", "speaker", "tvman", "scientist", "morph", 
        "selector", "display", "stand", "pad", "spawn", "quest", 
        "npc", "reward", "rank", "top", "statue"
    }
    
    for _, word in ipairs(blacklist) do
        if string.find(mobName, word) or string.find(parentName, word) then
            return false
        end
    end
    
    -- Kiểm tra nếu nằm trong thư mục quái chuẩn của Game
    if string.find(parentName, "wave") or string.find(parentName, "enemy") or string.find(parentName, "enemies") or string.find(parentName, "mobs") or string.find(parentName, "spawns") then
        return true
    end
    
    -- Kiểm tra tên quái có chứa từ khóa Toilet / Enemy không
    if string.find(mobName, "toilet") or string.find(mobName, "skibidi") or string.find(mobName, "astro") or string.find(mobName, "boss") or string.find(mobName, "mutant") or string.find(mobName, "parasite") then
        return true
    end
    
    -- Nếu không nằm trong folder quái và không có từ khóa quái -> Bỏ qua
    return false
end

