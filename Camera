-- Hàm Read (đọc JSON)
d.Read = function(p)
	if (not d.FS or not isfile(p)) then
		return nil;
	end
	local w, x = pcall(function()
		return h:JSONDecode(readfile(p));
	end);
	return (w and (type(x) == "table") and x) or nil;
end;

-- Hàm Write (ghi JSON an toàn)
d.Write = function(p, x)
	if not d.FS then
		return false, "Filesystem không khả dụng";
	end
	local w, y = pcall(function()
		local z = h:JSONEncode(x);
		writefile(p .. ".tmp", z);
		assert(readfile(p .. ".tmp") == z, "Ghi file thất bại");
		assert(type(h:JSONDecode(z)) == "table", "Xác thực JSON thất bại");
		if isfile(p) then
			writefile(p .. ".bak", readfile(p));
		end
		writefile(p, z);
		assert(readfile(p) == z, "Đọc lại file thất bại");
		if (type(delfile) == "function") then
			delfile(p .. ".tmp");
		end
	end);
	return w, y;
end;

