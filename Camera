function Methods:Slider(name, min, max, default, callback, unit, desc)
	local h = desc and 52 or 42
	local f = self:_item(name .. " " .. (desc or ""), h)
	new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 16),
		Position = UDim2.fromOffset(10, 6),
		BackgroundTransparency = 1,
		Text = name,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, f)
	if desc then
		new("TextLabel", {
			Size = UDim2.new(1, -20, 0, 14),
			Position = UDim2.fromOffset(10, 21),
			BackgroundTransparency = 1,
			Text = desc,
			Font = Enum.Font.Gotham,
			TextSize = 9,
			TextColor3 = T.Sub,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, f)
	end
	local val = new("TextLabel", {
		Size = UDim2.new(1, -78, 0, 6),
		BackgroundTransparency = 1,
		Text = tostring(default) .. (unit or ""),
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, f)
	paint(val, "TextColor3", "Accent")
	local track = new("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.fromOffset(10, h - 14),
		BackgroundColor3 = T.Off,
	}, f)
	corner(track, 3)
	local fill = new("Frame", {Size = UDim2.fromScale(0, 1)}, track)
	corner(fill, 3)
	paint(fill, "BackgroundColor3", "Accent")
	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, track)
	corner(knob, 7)
	paint(stroke(knob, T.Accent, 1.5), "Color", "Accent")

	local function set(a, silent)
		a = math.clamp(a, 0, 1)
		local v = math.floor(min + (max - min) * a + 0.5)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		val.Text = tostring(v) .. (unit or "")
		if callback and not silent then callback(v) end
	end
	set((default - min) / (max - min), true)

	local sliding = false
	local function fromX(x)
		set((x - track.AbsolutePosition.X) / track.AbsoluteSize.X)
	end
	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, h - 26),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
	}, f)
	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			sliding = true
			self.Frame.ScrollingEnabled = false
			tween(knob, 0.12, {Size = UDim2.fromOffset(18, 18)}, Enum.EasingStyle.Back)
			fromX(i.Position.X)
		end
	end)
	bind(UIS.InputChanged, function(i)
		if sliding and isMove(i) then fromX(i.Position.X) end
	end)
	bind(UIS.InputEnded, function(i)
		if sliding and isPress(i) then
			sliding = false
			self.Frame.ScrollingEnabled = true
			tween(knob, 0.15, {Size = UDim2.fromOffset(14, 14)}, Enum.EasingStyle.Back)
		end
	end)
end

function Methods:Dropdown(name, options, default, callback, desc)
	local f, h = self:_row(name, desc, 120)
	local btn = new("TextButton", {
		Size = UDim2.fromOffset(110, 24),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0, h / 2),
		BackgroundColor3 = T.Panel,
		Text = default or options[1],
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false,
	}, f)
	corner(btn, 6)
	stroke(btn, T.Line)
	new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 20)}, btn)
	paint(btn, "TextColor3", "Accent")
	local arrow = new("TextLabel", {
		Size = UDim2.fromOffset(14, 24),
		Position = UDim2.new(1, -26, 0, h / 2 - 12),
		BackgroundTransparency = 1,
		Text = ">",
		Font = Enum.Font.GothamBold,
		TextSize = 11,
	}, f)
	paint(arrow, "TextColor3", "Accent")
	local list = new("Frame", {
		Size = UDim2.new(1, -16, 0, #options * 24),
		Position = UDim2.fromOffset(8, h + 4),
		BackgroundTransparency = 1,
	}, f)
	new("UIListLayout", {Padding = UDim.new(0, 2)}, list)
	local open = false
	local function setOpen(v)
		open = v
		tween(f, 0.22, {Size = UDim2.new(1, 0, 0, open and (h + 6 + #options * 24) or h)})
		tween(arrow, 0.2, {Rotation = open and 90 or 0})
	end
	for _, opt in ipairs(options) do
		local o = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundColor3 = T.Panel,
			Text = opt,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = T.Text,
			AutoButtonColor = false,
		}, list)
		corner(o, 4)
		press(o, 0.96)
		o.MouseEnter:Connect(function() tween(o, 0.12, {BackgroundColor3 = T.AccentDark}) end)
		o.MouseLeave:Connect(function() tween(o, 0.12, {BackgroundColor3 = T.Panel}) end)
		o.Activated:Connect(function()
			btn.Text = opt
			setOpen(false)
			if callback then callback(opt) end
		end)
	end
	btn.Activated:Connect(function() setOpen(not open) end)
	return function(v) btn.Text = v end
end

local function icon(kind, parent)
	local box = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		BackgroundTransparency = 1,
	}, parent)
	local function fillPart(w, h2, x, y, r, rot)
		local p = new("Frame", {
			Size = UDim2.fromOffset(w, h2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Rotation = rot or 0,
			BorderSizePixel = 0,
		}, box)
		corner(p, r or 1)
		paint(p, "BackgroundColor3", "Accent")
	end
	local function ringPart(size, thick)
		local p = new("Frame", {
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(7, 7),
			BackgroundTransparency = 1,
		}, box)
		corner(p, size)
		paint(stroke(p, T.Accent, thick), "Color", "Accent")
	end
	if kind == "ring" then
		ringPart(12, 2)
	elseif kind == "dotring" then
		ringPart(12, 2)
		fillPart(3, 3, 7, 7, 1)
	elseif kind == "diamond" then
		fillPart(8, 8, 7, 7, 1, 45)
	elseif kind == "square" then
		local p = new("Frame", {
			Size = UDim2.fromOffset(10, 10),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(7, 7),
			BackgroundTransparency = 1,
		}, box)
		corner(p, 2)
		paint(stroke(p, T.Accent, 2), "Color", "Accent")
	elseif kind == "bars" then
		fillPart(12, 2, 7, 3)
		fillPart(8, 2, 5, 7)
		fillPart(10, 2, 6, 11)
	elseif kind == "shield" then
		fillPart(10, 12, 7, 7, 2)
	else
		fillPart(12, 2, 7, 7)
		fillPart(2, 12, 7, 7)
	end
end

