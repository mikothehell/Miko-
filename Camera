d.QuestStep = function()
	if (not k.AutoClaimQuest or (game.PlaceId ~= d.LobbyId) or d.Teleporting) then
		return;
	end
	if (os.clock() < (d.Next.Quest or 0)) then
		return;
	end
	d.Next.Quest = os.clock() + 2;
	local aa = d.ClaimableQuests();
	local ab = {};
	for a0, a1 in ipairs(aa) do
		ab[a1.Key] = true;
	end
	for t in pairs(d.QuestClaims) do
		if not ab[t] then
			d.QuestClaims[t] = nil;
		end
	end
	for a0, a1 in ipairs(aa) do
		local K = d.QuestClaims[a1.Key];
		if (not K or (not K.Accepted and (os.clock() >= K.NextAt))) then
			local ac = {["NextAt"]=(os.clock() + 30)};
			d.QuestClaims[a1.Key] = ac;
			local w, R, ad = d.Invoke("ClaimQuest", a1.Id, a1.Type);
			if (w and (R == true)) then
				ac.Accepted = true;
				d.SetStatus("Quest", "Đã nhận thưởng: " .. a1.Id);
			else
				d.SetStatus("Quest", "Lỗi nhận: " .. a1.Id .. " (" .. tostring(ad or R) .. ")");
			end
			return;
		end
	end
	d.SetStatus("Quest", ((#aa == 0) and "Không có quest nào có thể nhận" or "Đang chờ quest có sẵn"));
end;

