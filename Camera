				local t = _ .. ":" .. a1.Id;
				local a2, P = tonumber(a1.CurrentProgress), tonumber(a1.Progress);
				local a3 = (a1.Completed == true) or (a1.State == "Completed") or (a2 and P and (P > 0) and (a2 >= P));
				if (a3 and (a1.RewardClaimed ~= true)) then
					table.insert(Y, {["Id"]=a1.Id,["Key"]=t,["Type"]="daily"});
