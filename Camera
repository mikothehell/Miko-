		BackgroundColor3 = T.Off,
	}, f)
	corner(sw, 9)
	local sst = stroke(sw, T.Accent, 1)
	sst.Transparency = 0.55
	paint(sst, "Color", "Accent")
	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, sw)
	corner(knob, 7)
	local state = default and true or false
	local function render()
		tween(sw, 0.2, {BackgroundColor3 = state and T.Accent or T.Off})
		tween(knob, 0.25, {Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)}, Enum.EasingStyle.Back)
		tween(edge, 0.25, {Size = state and UDim2.fromOffset(2, h - 12) or UDim2.fromOffset(2, 0)}, Enum.EasingStyle.Back)
	end
	skin(render)
	local hit = new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
	}, f)
	hit.InputBegan:Connect(function(i)
		if isPress(i) then ripple(f, i) end
	end)
	hit.Activated:Connect(function()
		state = not state
		render()
		if callback then callback(state) end
	end)
end

