local bubble = new("ImageButton", {
	Size = UDim2.fromOffset(38, 38),
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.82, 0.62),
	BackgroundColor3 = T.Bg,
	BackgroundTransparency = 0.1,
	Image = "rbxassetid://103525855196551",
	AutoButtonColor = false,
	Visible = false,
}, gui)
new("UICorner", {CornerRadius = UDim.new(0.5, 0)})
borderFx(stroke(bubble, Color3.new(1, 1, 1), 2), bubble)
local bubbleScale = new("UIScale", {Scale = 1}, bubble)

local minimized = false

local function restore()
	if not minimized then return end
	minimized = false
	root.Position = UDim2.fromScale(0.5, 0.5)
	bubble.Visible = false
	root.Visible = true
	animScale.Scale = 0.2
	tween(animScale, 0.35, {Scale = 1}, Enum.EasingStyle.Back)
end

minimize = function()
	if minimized then return end
	minimized = true
	local tw = tween(animScale, 0.22, {Scale = 0.01}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tw.Completed:Connect(function()
		if minimized then
			root.Visible = false
			bubble.Visible = true
			bubbleScale.Scale = 0.01
			tween(bubbleScale, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
		end
	end)
end

local dragActive, dragStart, origPos = false, nil, nil
bubble.InputBegan:Connect(function(i)
	if isPress(i) then
		dragActive, dragStart, origPos = true, i.Position, bubble.Position
	end
end)

bind(UIS.InputChanged, function(i)
	if dragActive and isMove(i) then
		local delta = i.Position - dragStart
		bubble.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + delta.X, origPos.Y.Scale, origPos.Y.Offset + delta.Y)
	end
end)

bind(UIS.InputEnded, function(i)
	if dragActive and isPress(i) then
		dragActive = false
	end
end)

bubble.Activated:Connect(restore)
minBtn.Activated:Connect(minimize)
closeBtn.Activated:Connect(closeAll)

bind(UIS.InputBegan, function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightShift then
		if minimized then restore() else minimize() end
	end
end)

