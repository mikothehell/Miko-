	local du = {3,10,20};
	dq.Log = function(H, x)
		dq.LastEvent = {["Type"]=H,["Data"]=x,["At"]=os.clock()};
	end;
	dq.Status = function(U)
		dq.Message = U;
	end;
	dq.Connect = function(l, m)
		table.insert(dq.Connections, l:Connect(function(...)
			if dq.Active then
