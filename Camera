d.ActionReady = function(aP, bu, bv, bw)
	local bx = d.Cash() >= (tonumber(aP.Cost) or 0);
	if (bv == "replay") then
		return (d.GameClock() - bu) >= (tonumber(aP.Time) or 0);
	end
	if (bv == "live") then
		return bx;
	end
	if (aP.Kind == "skip") then
		local P = tonumber(aP.Wave) or 0;
		local bo = d.Wave();
		if ((bo > P) or ((bo == P) and d.SkipVoteComplete(P))) then
			return true;
		end
		if (bo < P) then
			return false;
		end
		if (tonumber(aP.WaveTime) and d.WaveStartedGame) then
			return (d.GameClock() - d.WaveStartedGame) >= math.max(0, tonumber(aP.WaveTime));
		end
		local K = bw and bw.Previous;
		if (K and (tonumber(K.Wave) == P)) then
			local by = math.max(0, (tonumber(aP.Time) or 0) - (tonumber(K.Time) or 0));
			return (d.GameClock() - (bw.CompletedAt or bu)) >= by;
		end
		return (d.GameClock() - bu) >= (tonumber(aP.Time) or 0);
	end
	return (d.Wave() >= (tonumber(aP.Wave) or 0)) and bx;
end;

