			d.SetStatus("Info", ((ba and ba.Text) or "Cash") .. " | " .. d.Cash() .. " | " .. #d.Owned());
			d.SetStatus("Wave", ((ba and ba.Text) or "Wave") .. " | " .. k.PlaybackMode .. " | " .. d.Cash());
			local e7 = d.Recording;
			local ax = (e7 and #e7.Profile.Actions) or (d.LoadedProfile and #d.LoadedProfile.Actions) or 0;
			pcall(function()
				if d.Widgets.Macro then
					d.Widgets.Macro:SetTitle((e7 and "Đang ghi macro...") or (d.Playing and "Đang phát macro...") or (d.PlaybackFailure and "Phát thất bại") or (k.AutoPlayback and "Tự động phát đang bật") or "Ghi/Phát macro");
				end
				if d.Widgets.MacroActions then
					d.Widgets.MacroActions:SetTitle("Số hành động: " .. ax);
				end
			end);
			d.SetStatus("MacroInfo", (e7 and ("Đang ghi: " .. #e7.Profile.Actions)) or (d.Playing and string.format("Đang phát: %d/%d", d.PlaybackIndex or 0, d.PlaybackTotal or 0)) or string.format("Profile: %s (%d hành động)", ((k.Profile ~= "") and k.Profile) or "default", (d.LoadedProfile and #d.LoadedProfile.Actions) or 0));
			if (k.AutoDifficulty and not d.SoloReturning and (game.PlaceId == d.MatchId) and d.Visible(d.GUI("VoteUI/Vote" .. k.Difficulty .. "Button")) and (M >= (d.Next.Vote or 0))) then
				d.Next.Vote = M + 2;
				d.Fire("VoteDifficulty", k.Difficulty);
			end
			if S then
				if d.Recording then
					d.StopRecord();
				end
				if d.Playing then
					d.StopPlayback("Trận kết thúc");
				end
				d.EndMatchStep(W);
			end
			d.AutoPlaybackStep(bK, M);
			d.LastWave = bo;
			d.Visual();
		end);
		if not w then
			d.SetStatus("Error", "Lỗi vòng lặp: " .. tostring(y));
		end
		task.wait(0.3);
	end
end);

