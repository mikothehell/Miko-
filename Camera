-- Metatable Hooking for PlaceAnywhere
local rawmt = getrawmetatable(game)
local oldNamecall = rawmt.__namecall
setreadonly(rawmt, false)

rawmt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if Flags.PlaceAnywhere and method == "FireServer" and tostring(self) == "ClosePlacement" then
        return nil
    end
    
    return oldNamecall(self, ...)
end)

setreadonly(rawmt, true)

-- Auto Loops for In-Game Logic
task.spawn(function()
    while task.wait(2) do
        -- Auto Vote Difficulty
        if Flags.AutoVote then
            pcall(function()
                ReplicatedStorage.RemoteEvents.VoteDifficulty:FireServer(Flags.SelectedDifficulty)
            end)
        end
        
        -- Auto Skip Wave
        if Flags.AutoSkip then
            pcall(function()
                local currentWave = workspace:FindFirstChild("Wave") and workspace.Wave.Value or 0
                if currentWave < Flags.StopSkipWave then
                    ReplicatedStorage.RemoteEvents.SkipWave:FireServer()
                end
            end)
        end
        
        -- Auto Replay
        if Flags.AutoReplay then
            pcall(function()
                if workspace:FindFirstChild("MatchEnd") and workspace.MatchEnd.Value then
                    ReplicatedStorage.RemoteEvents.ReplayMatch:FireServer()
                end
            end)
        end
        
        -- Auto Claim Quest
        if Flags.AutoClaimQuest then
            pcall(function()
                ReplicatedStorage.RemoteEvents.ClaimDailyQuest:FireServer()
            end)
        end
    end
end)

