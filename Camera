d.SpeedStep = function()
	if (not k.AutoSpeed or not d.Active() or d.Speed.Busy) then
		return;
	end
	local P = k.SpeedScale;
	if ((d.Speed.Applied == P) and (d.Speed.Value == P)) then
		return;
	end
	if ((d.Speed.Rejected == P) or (os.clock() < (d.Next.Speed or 0))) then
		return;
	end
	d.Speed.Busy = true;
	d.Next.Speed = os.clock() + 5;
	local Q = d.Speed.Revision;
	local w, R = d.Invoke("SetGameSpeed", P);
	d.Speed.Busy = false;
	if not d.Running then
		return;
	end
	if (w and (R == true)) then
		if (Q == d.Speed.Revision) then
			d.ConfirmSpeed(P);
		end
		d.Speed.Applied = P;
		d.SetStatus("Speed", "Đã đặt tốc độ " .. d.Speed.Value .. "x");
	elseif (w and (R == false)) then
		d.Speed.Rejected = P;
		d.SetStatus("Speed", "Từ chối tốc độ " .. P .. "x, giữ " .. d.Speed.Value .. "x");
		d.Notify("Không thể đặt tốc độ " .. P .. "x. Máy chủ từ chối. Đang dùng " .. d.Speed.Value .. "x.");
	else
		d.SetStatus("Speed", "Lỗi gửi yêu cầu tốc độ");
	end
end;

