		return ((#dy > 0) and table.concat(dy, " ")) or nil;
	end;
	dq.ConnectionError = function(U)
		if (type(U) ~= "string") then
			return false;
		end
		local dz = U:lower();
		if dz:match("disconnected due to an error") then
			return true;
		end
		return (dz:find("connection lost", 1, true) ~= nil) or (dz:find("lost connection", 1, true) ~= nil) or (dz:find("disconnected from", 1, true) ~= nil) or (dz:find("failed to connect", 1, true) ~= nil) or (dz:find("kicked from", 1, true) ~= nil) or (dz:find("error code 267", 1, true) ~= nil) or (dz:find("network error", 1, true) ~= nil);
	end;
	dq.Reset = function()
		dq.Prompt, dq.Attempts, dq.NextAt, dq.InFlight = nil, 0, nil, nil;
	end;
	dq.Step = function(U)
		if (not dq.Active or not dq.Armed) then
			return;
		end
		local M = os.clock();
		if dq.InFlight then
			if ((M - dq.InFlight) < 45) then
				return;
			end
			dq.InFlight = nil;
			dq.Log("Rejoin timeout", {["Attempts"]=dq.Attempts});
		end
		if not U then
			if dq.Prompt then
				dq.Reset();
				dq.Log("Prompt dismissed", {});
			end
			dq.Status("Đang chờ lỗi kết nối...");
			return;
		end
		if not dq.ConnectionError(U) then
			if dq.Prompt then
				dq.Reset();
			end
			dq.Status("Prompt không phải lỗi kết nối, bỏ qua");
			return;
		end
		if not dq.Prompt then
			dq.Prompt = U;
			dq.Attempts = 0;
			dq.NextAt = M + du[1];
			dq.Log("Error detected", {["Message"]=U});
		end
		if (dq.Attempts >= #du) then
			dq.Status("Đã thử lại nhiều lần, dừng rejoin");
			return;
		end
		if (M < dq.NextAt) then
			dq.Status("Thử lại lần " .. (dq.Attempts + 1) .. " sau " .. math.ceil(dq.NextAt - M) .. "s");
			return;
		end
		dq.Attempts = dq.Attempts + 1;
		dq.NextAt = M + (du[dq.Attempts + 1] or 30);
		dq.Log("Rejoin attempt", {["Attempt"]=dq.Attempts,["PlaceId"]=dt});
		local b9 = b.CameraTDHub;
		if (b9 and b9.Running and b9.QueueTeleport) then
			pcall(b9.QueueTeleport);
		end
		local w, ad = pcall(function()
			dr:Teleport(dt, j);
		end);
		if not w then
			dq.Log("Rejoin error", {["Attempt"]=dq.Attempts,["Error"]=tostring(ad)});
			dq.Status("Teleport thất bại, thử lại sau");
		else
			dq.Status("Đã gửi yêu cầu rejoin");
		end
	end;
	dq.Stop = function()
		if not dq.Active then
			return;
		end
		dq.Active, dq.Armed = false, false;
		for a0, aO in ipairs(dq.Connections) do
			aO:Disconnect();
		end
		dq.Log("Stopped", {["Attempts"]=dq.Attempts});
	end;
	dq.Connect(dr.TeleportInitFailed, function(c0, Y, s, dA)
		if ((c0 ~= j) or (dA ~= dt) or (dq.Attempts == 0)) then
			return;
		end
		dq.InFlight = nil;
		dq.Log("Teleport failed", {["Result"]=tostring(Y),["Message"]=tostring(s),["Attempt"]=dq.Attempts});
	end);
	dq.Connect(j.OnTeleport, function(d7)
		if (dq.Attempts == 0) then
			return;
		end
		dq.Log("Teleport state", {["State"]=tostring(d7)});
		if ((d7 == Enum.TeleportState.Started) or (d7 == Enum.TeleportState.InProgress)) then
			dq.InFlight = dq.InFlight or os.clock();
			dq.Status("Đang teleport...");
		elseif (d7 == Enum.TeleportState.Failed) then
			dq.InFlight = nil;
		end
	end);
	task.spawn(function()
		while d.Running and dq.Active do
			local w, U = pcall(dq.ReadPrompt);
			if w then
				local dB, bH = pcall(dq.Step, U);
				if not dB then
					dq.Log("Step error", {["Error"]=tostring(bH)});
				end
			else
				dq.Log("Read error", {["Error"]=tostring(U)});
			end
			task.wait(1);
		end
	end);
end;

