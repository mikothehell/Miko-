-- MACRO TAB
MacroTab:Section({ Title = "Macro Recording & Playback" })

local isRecording = false
local isPlaying = false
local currentMacroData = {}

MacroTab:Button({
    Title = "Start / Stop Recording",
    Callback = function()
        isRecording = not isRecording
        if isRecording then
            currentMacroData = {}
            WindUI:Notify({ Title = "Macro", Content = "Recording Started!", Duration = 3 })
        else
            WindUI:Notify({ Title = "Macro", Content = "Recording Stopped! Total Actions: " .. #currentMacroData, Duration = 3 })
        end
    end
})

MacroTab:Button({
    Title = "Save Macro Profile",
    Callback = function()
        if #currentMacroData > 0 and writefile then
            if not isfolder("MikoHub_Macros") then makefolder("MikoHub_Macros") end
            writefile("MikoHub_Macros/CameraTD_Profile.json", HttpService:JSONEncode(currentMacroData))
            WindUI:Notify({ Title = "Macro", Content = "Macro Saved Successfully!", Duration = 3 })
        end
    end
})

MacroTab:Button({
    Title = "Load & Run Macro",
    Callback = function()
        if readfile and isfile("MikoHub_Macros/CameraTD_Profile.json") then
            currentMacroData = HttpService:JSONDecode(readfile("MikoHub_Macros/CameraTD_Profile.json"))
            isPlaying = true
            WindUI:Notify({ Title = "Macro", Content = "Executing Macro...", Duration = 3 })
            
            task.spawn(function()
                for _, action in ipairs(currentMacroData) do
                    if not isPlaying then break end
                    task.wait(action.Delay or 1)
                    if action.Type == "Place" then
                        pcall(function()
                            ReplicatedStorage.RemoteEvents.PlaceTower:FireServer(action.TowerName, action.CFrame)
                        end)
                    elseif action.Type == "Upgrade" then
                        pcall(function()
                            ReplicatedStorage.RemoteEvents.UpgradeTower:FireServer(action.TowerModel)
                        end)
                    end
                end
                isPlaying = false
                WindUI:Notify({ Title = "Macro", Content = "Macro Execution Finished!", Duration = 3 })
            end)
        else
            WindUI:Notify({ Title = "Macro Error", Content = "No saved macro found!", Duration = 3 })
        end
    end
})

