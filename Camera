			end
		end
	else
		local a4 = d.Path(j:FindFirstChild("PlayerGui"), "QuestUI/Quests/QuestsFrame");
		if a4 then
			for a0, a5 in ipairs(a4:GetChildren()) do
				if (a5.Name ~= "Template") then
					local a6 = d.Path(a5, "Progress/ProgressText");
					local a7 = d.Path(a5, "ClaimButton");
					local E = d.Path(a5, "RewardIcon");
					local a2, P;
					if a6 then
						a2, P = a6.Text:match("(%d+)%s*/%s*(%d+)");
					end
					if (a2 and (tonumber(P) > 0) and (tonumber(a2) >= tonumber(P)) and a7 and a7.Visible and not (E and E.Visible)) then
						table.insert(Y, {["Id"]=a5.Name,["Key"]=("quest_" .. a5.Name),["Type"]="daily"});
					end
