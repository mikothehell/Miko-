-- Dynamic Remote Finder & Cache
local function CacheCombatRemotes()
    RemoteCache = {}
    
    local function ScanContainer(container)
        if not container then return end
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local lname = string.lower(obj.Name)
                if string.find(lname, "punch") or string.find(lname, "attack") or string.find(lname, "hit") or string.find(lname, "combat") or string.find(lname, "damage") or string.find(lname, "m1") then
                    table.insert(RemoteCache, obj)
                end
            end
        end
    end

    ScanContainer(ReplicatedStorage)
    if LocalPlayer.Character then
        ScanContainer(LocalPlayer.Character)
    end
end

-- Refresh Remotes Initially and on Character Respawn
