local function calculateFarmCFrame(enemyHrp)
    local pos = _G.FarmPosition
    local dist = _G.FarmDistance
    
    if pos == "Above" then
        return enemyHrp.CFrame * CFrame.new(0, dist, 0) * CFrame.Angles(math.rad(-90), 0, 0)
    elseif pos == "Underground" then
        return enemyHrp.CFrame * CFrame.new(0, -dist, 0) * CFrame.Angles(math.rad(90), 0, 0)
    elseif pos == "Behind" then
        return enemyHrp.CFrame * CFrame.new(0, 0, dist)
    elseif pos == "In Front" then
        return enemyHrp.CFrame * CFrame.new(0, 0, -dist) * CFrame.Angles(0, math.rad(180), 0)
    end
    
    return enemyHrp.CFrame * CFrame.new(0, -dist, 0)
end

-- HÀM QUÉT TOILET GẦN NHẤT
local function getNearestToilet()
    local closest = nil
    local shortestDist = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Humanoid") and v.Parent and isValidToilet(v.Parent) then
            local mob = v.Parent
            local hrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head") or mob:FindFirstChild("Torso") or mob.PrimaryPart
            if hrp then
                local dist = (myPos - hrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = mob
                end
            end
        end
    end
    return closest
end

-- VÒNG LẶP DI CHUYỂN AUTO FARM TOILET
RunService.Heartbeat:Connect(function()
    if _G.AutoFarm and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Physics then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end

            if currentTarget then
                if not currentTarget.Parent or not isValidToilet(currentTarget) then
                    currentTarget = nil
                end
            end

            if currentTarget then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero

                local enemyHrp = currentTarget:FindFirstChild("HumanoidRootPart") or currentTarget:FindFirstChild("Head") or currentTarget:FindFirstChild("Torso") or currentTarget.PrimaryPart
                if enemyHrp then
                    hrp.CFrame = calculateFarmCFrame(enemyHrp)
                end
            end
        end
    end
end)

local function executeSmartCombat(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if _G.AutoSkill and not isExecutingSkills then
        local currentTime = tick()
        if currentTime - lastSkillUsedTime >= _G.SkillDelay then
            lastSkillUsedTime = currentTime
            isExecutingSkills = true

            task.spawn(function()
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                local tools = {}
                if backpack then
                    for _, item in pairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then
                            table.insert(tools, item)
                        end
                    end
                end

                for i = 1, 10 do
                    if not _G.AutoSkill or not _G.AutoFarm then break end
                    if _G.SelectedSkills[i] then
                        local key = skillKeyCodes[i]
                        if key then
                            VirtualInputManager:SendKeyEvent(true, key, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, key, false, game)
                        end

                        if tools[i] and tools[i].Parent == backpack then
                            pcall(function()
                                hum:EquipTool(tools[i])
                                task.wait(0.02)
                                tools[i]:Activate()
                            end)
                        end

                        task.wait(0.02)
                    end
                end

                isExecutingSkills = false
            end)
        end
    end

    if _G.AutoLetterKeys then
        task.spawn(function()
            for keyChar, isEnabled in pairs(_G.SelectedLetterKeys) do
                if isEnabled and Enum.KeyCode[keyChar] then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[keyChar], false, game)
                    task.wait(0.015)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[keyChar], false, game)
                end
            end
        end)
    end

    if _G.AutoPunch then
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

