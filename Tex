-- HÀM NHẬN DIỆN TOILET CHUẨN XÁC 100%
local function isValidToilet(mob)
    if not mob or not mob:IsA("Model") then return false end
    
    local char = LocalPlayer.Character
    if char and (mob == char or mob:IsDescendantOf(char)) then 
        return false 
    end
    
    -- Kiểm tra xem có phải người chơi khác không
    if Players:GetPlayerFromCharacter(mob) then return false end
    
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    
    local mobName = string.lower(mob.Name)
    local parentName = mob.Parent and string.lower(mob.Parent.Name) or ""
    
    -- Loại trừ NPC sảnh/Lobby/Dummy
    if string.find(mobName, "dummy") or string.find(mobName, "shop") or string.find(mobName, "roblox") then
        return false
    end
    if string.find(parentName, "lobby") or string.find(parentName, "safe") then
        return false
    end
    
    -- Bắt buộc là Toilet hoặc Mob trong khu vực chiến đấu
    if string.find(mobName, "toilet") or string.find(parentName, "toilet") or string.find(parentName, "wave") or string.find(parentName, "enemy") or string.find(parentName, "enemies") or string.find(parentName, "mobs") then
        return true
    end
    
    -- Nếu không khớp tên folder nhưng có Humanoid và ở ngoài khu vực chiến đấu thì vẫn chấp nhận
    local hrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head") or mob.PrimaryPart
    if hrp then
        return true
    end

    return false
end

