-- =======================================================
-- Helper Functions
-- =======================================================
local function GetCurrentPoints()
    local points = 0
    pcall(function()
        if LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Points") then
            points = LocalPlayer.leaderstats.Points.Value
        elseif LocalPlayer:FindFirstChild("Points") then
            points = LocalPlayer.Points.Value
        end
    end)
    return points
end

local function GetTrueEnemy()
    local targetHRP = nil
    local shortestDistance = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    local enemyFolder = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("Boxes") or Workspace:FindFirstChild("Mobs") or Workspace
    local candidates = enemyFolder:GetChildren()
    if enemyFolder == Workspace then
        candidates = Workspace:GetDescendants()
    end

    for _, obj in pairs(candidates) do
        if obj:IsA("Model") and obj ~= char then
            local isPlayer = Players:GetPlayerFromCharacter(obj)
            local isFriendly = string.find(string.lower(obj.Name), "ally") or string.find(string.lower(obj.Name), "player") or string.find(string.lower(obj.Name), "defender")
            
            if not isPlayer and not isFriendly then
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildWhichIsA("BasePart")
                
                if hrp and humanoid and humanoid.Health > 0 then
                    local dist = (myPos - hrp.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        targetHRP = hrp
                    end
                end
            end
        end
    end
    return targetHRP
end

-- =======================================================
-- Loop 1: Auto Farm & Update Stats GUI
-- =======================================================
task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AutoFarm then
            local currentPoints = GetCurrentPoints()
            earnedPoints = math.max(0, currentPoints - startPoints)
            local elapsed = math.floor(os.time() - startTime)
            local hrs = math.floor(elapsed / 3600)
            local mins = math.floor((elapsed % 3600) / 60)
            local secs = elapsed % 60

            PointsLabel.Text = "POINTS: " .. tostring(currentPoints)
            EarnedLabel.Text = "EARNED: " .. tostring(earnedPoints)
            TimeValueLabel.Text = string.format("%02d:%02d:%02d", hrs, mins, secs)

            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                    local targetPart = GetTrueEnemy()
                    if targetPart and targetPart.Parent then
                        char.HumanoidRootPart.CFrame = targetPart.CFrame * CFrame.new(0, _G.FarmHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        
                        local tool = char:FindFirstChildOfClass("Tool")
                        if not tool then
                            local backpackTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                            if backpackTool then
                                char.Humanoid:EquipTool(backpackTool)
                            end
                        else
                            tool:Activate()
                            VirtualUser:CaptureController()
                            VirtualUser:ClickButton1(Vector2.new(0, 0))
                        end
                    end
                end
            end)
        end
    end
end)

-- =======================================================
-- Loop 2: Auto Skill (Separate from Auto Farm)
-- Keybind List: E, F, G, Q, R, T, X, Z, Shift, Space
-- =======================================================
local skillKeys = {
    Enum.KeyCode.E, Enum.KeyCode.F, Enum.KeyCode.G, Enum.KeyCode.Q,
    Enum.KeyCode.R, Enum.KeyCode.T, Enum.KeyCode.X, Enum.KeyCode.Z,
    Enum.KeyCode.LeftShift, Enum.KeyCode.Space
}

task.spawn(function()
    while true do
        task.wait(_G.SkillDelay)
        if _G.AutoSkill then
            pcall(function()
                for _, key in ipairs(skillKeys) do
                    if not _G.AutoSkill then break end
                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                    task.wait(0.02)
                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                end
            end)
        end
    end
end)

