            State.ResetDeadline = nil
            continue
        end

        if State.Resetting then
            continue
        end

        if not State.ResetDeadline then
            ScheduleReset()
            continue
        end

        if os.clock() >= State.ResetDeadline then
            ResetCharacter()
        end
    end
end)

