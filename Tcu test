-- POST-READY SETUP & PERSISTENT LOOPS
--========================================================

local function RunSetup()
    if State.SetupRunning then
        return
    end

    if not (
        AutoBuyTransform
        or AutoTPFreeze
        or AutoTSMBattleArmor
        or AutoTTVCinema
    ) then
        return
    end

    State.SetupRunning = true

    task.spawn(function()
        task.wait(2)

        local cycle = State.Cycle

        if AutoBuyTransform and not State.BuyTransformDoneThisCycle then
            if cycle ~= State.Cycle then
                State.SetupRunning = false
                return
            end

            if not State.BuyTransformPurchasedThisCycle then
                local callOK, purchaseSuccess = BuyProtocol(true)

                if callOK and purchaseSuccess then
                    State.BuyTransformPurchasedThisCycle = true
                    print("[Miko Hub] Auto Buy + Transform -> Playable Protocol purchased")
                else
                    print("[Miko Hub] Auto Buy + Transform -> purchase not confirmed, will retry")
                end
            end

            if State.BuyTransformPurchasedThisCycle and not State.BuyTransformDoneThisCycle then
                task.wait(1)

                if cycle ~= State.Cycle or not AutoBuyTransform then
                    State.SetupRunning = false
                    return
                end

                if not HasPlayableProtocol() then
                    print("[Miko Hub] Waiting for Playable Protocol replication before transform")
                    if not WaitForPlayableProtocol(PLAYABLE_PROTOCOL_WAIT) then
                        print("[Miko Hub] Transform delayed: Playable Protocol not confirmed")
                        State.SetupRunning = false
                        return
                    end
                end

                if Transform(true) then
                    State.BuyTransformDoneThisCycle = true
                    print("[Miko Hub] Auto Buy + Transform ->", SelectedTransformTarget, "DONE")
                end
            end
        end

        if AutoTPFreeze then
            if AutoBuyTransform and not State.BuyTransformDoneThisCycle then
                print("[Miko Hub] Transform not confirmed -> skipping Tween/Freeze this setup pass")
            else
                if AutoBuyTransform and State.BuyTransformDoneThisCycle then
                    print(string.format("[Miko Hub] Transform complete -> waiting %ss before Tween/Freeze", tostring(PostTransformTweenDelay)))
                    task.wait(PostTransformTweenDelay)
                else
                    task.wait(TPDelay)
                end

                if cycle ~= State.Cycle then
                    State.SetupRunning = false
                    return
                end

                local tweenSuccess = TPFreeze()

                if tweenSuccess and AutoBuyTransform and State.BuyTransformDoneThisCycle then
                    for retry = 1, PostTransformTweenRetries do
                        if not AutoTPFreeze or cycle ~= State.Cycle then
                            break
                        end

                        task.wait(PostTransformTweenRetryDelay)
                        print("[Miko Hub] Post-transform Tween retry:", retry, "/", PostTransformTweenRetries)
                        TPFreeze()
                    end
                end
            end
        end

        State.SetupRunning = false
        print("[Miko Hub] Setup finished | Transform:", SelectedTransformTarget, "| TSMBattleArmor:", AutoTSMBattleArmor, "| TTVCinema:", AutoTTVCinema)
    end)
end

