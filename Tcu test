local PLAYABLE_PROTOCOL_NAME = "Playable Protocol"
local PLAYABLE_PROTOCOL_WAIT = 8
local PLAYABLE_PROTOCOL_CLICK_INTERVAL = 0.8
local PLAYABLE_PROTOCOL_MAX_USE_TIME = 45

local function HasPlayableProtocol()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack and backpack:FindFirstChild(PLAYABLE_PROTOCOL_NAME) then
        return true
    end

    local character = LocalPlayer.Character
    if character and character:FindFirstChild(PLAYABLE_PROTOCOL_NAME) then
        return true
    end

    return false
end

local function WaitForPlayableProtocol(timeout)
    timeout = timeout or PLAYABLE_PROTOCOL_WAIT
    local deadline = os.clock() + timeout

    repeat
        if HasPlayableProtocol() then
            return true
        end
        task.wait(0.2)
    until os.clock() >= deadline

    return HasPlayableProtocol()
end

local function BuyProtocol(force)
    local now = os.clock()

    if HasPlayableProtocol() then
        print("[Miko Hub] Playable Protocol already exists in Backpack/Character")
        return true, true
    end

    if not force and now - State.LastBuy < 2 then
        return false, false
    end

    State.LastBuy = now

    local ok, result = pcall(function()
        return PurchaseItem:InvokeServer(
            "Player",
            PLAYABLE_PROTOCOL_NAME
        )
    end)

    if not ok then
        warn("[Miko Hub] Auto Buy error:", result)
        return false, false
    end

    if result == false then
        warn("[Miko Hub] Playable Protocol purchase returned FALSE")
        return true, false
    end

    print("[Miko Hub] Purchase request completed -> waiting for Backpack item")

    if WaitForPlayableProtocol(PLAYABLE_PROTOCOL_WAIT) then
        print("[Miko Hub] Playable Protocol CONFIRMED in Backpack/Character")
        return true, true
    end

    warn("[Miko Hub] Playable Protocol was not found after purchase request")
    return true, false
end

local function GetPlayableProtocolTool()
    local character = LocalPlayer.Character
    if character then
        local equipped = character:FindFirstChild(PLAYABLE_PROTOCOL_NAME)
        if equipped and equipped:IsA("Tool") then
            return equipped
        end
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild(PLAYABLE_PROTOCOL_NAME)
        if tool and tool:IsA("Tool") then
            return tool
        end
    end

    return nil
end

local function EquipPlayableProtocol(tool)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not tool or not humanoid then
        return false
    end

    if tool.Parent ~= character then
        local ok = pcall(function()
            humanoid:EquipTool(tool)
        end)
        if not ok then
            return false
        end
    end

    local deadline = os.clock() + 3
    repeat
        if tool.Parent == character then
            return true
        end
        task.wait(0.1)
    until os.clock() >= deadline

    return tool.Parent == character
end

local function ActivatePlayableProtocol(force)
    local now = os.clock()

    if State.BuyTransformDoneThisCycle or State.TransformCompletedThisCycle then
        print("[Miko Hub] Transform already completed this cycle -> skip duplicate use")
        return true
    end

    if not force and now - State.LastTransform < 3 then
        return false
    end

    State.LastTransform = now
    State.TransformInProgress = true
    State.TransformCharacterSwap = false

    local tool = GetPlayableProtocolTool()
    local originalCharacter = LocalPlayer.Character

    if not tool then
        State.TransformInProgress = false
        warn("[Miko Hub] Playable Protocol Tool was not found")
        return false
    end

    if not EquipPlayableProtocol(tool) then
        State.TransformInProgress = false
        warn("[Miko Hub] Could not equip Playable Protocol")
        return false
    end

    task.wait(0.15)

    local startedAt = os.clock()
    local attempt = 0
    local transformDetected = false

    while os.clock() - startedAt < PLAYABLE_PROTOCOL_MAX_USE_TIME do
        attempt += 1

        if LocalPlayer.Character ~= originalCharacter then
            transformDetected = true
            print("[Miko Hub] Character changed -> transform detected")
            break
        end

        if not tool or not tool.Parent then
            transformDetected = true
            print("[Miko Hub] Playable Protocol disappeared -> transform/use completed")
            break
        end

        if tool.Parent ~= LocalPlayer.Character then
            if not EquipPlayableProtocol(tool) then
                warn("[Miko Hub] Could not re-equip Playable Protocol")
                task.wait(PLAYABLE_PROTOCOL_CLICK_INTERVAL)
                continue
            end
            task.wait(0.1)
        end

        if not tool.Enabled then
            print("[Miko Hub] Playable Protocol busy -> waiting", attempt)
            task.wait(PLAYABLE_PROTOCOL_CLICK_INTERVAL)
            continue
        end

        local ok, err = pcall(function()
            tool:Activate()
        end)

        if not ok then
            warn("[Miko Hub] Playable Protocol click error:", err)
        else
            print("[Miko Hub] Playable Protocol click", attempt, "->", SelectedTransformTarget)
        end

        task.wait(PLAYABLE_PROTOCOL_CLICK_INTERVAL)
    end

    if not transformDetected then
        transformDetected = LocalPlayer.Character ~= originalCharacter
            or not tool
            or not tool.Parent
    end

    if not transformDetected then
        State.TransformInProgress = false
        State.TransformCharacterSwap = false
        warn("[Miko Hub] Transform was not confirmed within", PLAYABLE_PROTOCOL_MAX_USE_TIME, "seconds; stopping safely")
        return false
    end

    State.BuyTransformDoneThisCycle = true
    State.TransformCompletedThisCycle = true
    State.TransformInProgress = false
    State.TransformCharacterSwap = true

    print("[Miko Hub] Playable Protocol use completed ->", SelectedTransformTarget)

    if AutoStartLoop then
        AutoStartLoop = false
        if UpdateStartLoopUI then
            UpdateStartLoopUI(false)
        end
        print("[Miko Hub] Transform detected -> Start Loop OFF")
    end

    return true
end

local function Transform(force)
    return ActivatePlayableProtocol(force)
end

