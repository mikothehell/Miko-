    local _, hrp, _ = GetCharacter()
    if hrp then
        if #savedPositions == 0 then
            positionCounter = 0
        end
        positionCounter = positionCounter + 1
        local newPos = {
            id = positionCounter,
            cframe = hrp.CFrame,
            name = "Position " .. tostring(positionCounter)
