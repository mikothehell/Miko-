local function TPFreeze()
    local character, hrp, humanoid = GetCharacter()

    if not character or not hrp or not humanoid or humanoid.Health <= 0 then
        warn("[Miko Hub] Tween/Freeze: character not ready")
        return false
    end

    local ok, err = pcall(function()
        Unfreeze()

        State.FreezeSnapshot = {
            WalkSpeed = humanoid.WalkSpeed,
            JumpPower = humanoid.JumpPower,
            AutoRotate = humanoid.AutoRotate,
            PlatformStand = humanoid.PlatformStand
        }

        EnableNoclip()

        humanoid.AutoRotate = false
        humanoid.PlatformStand = false

        local selectedTeleportPosition = GetSelectedTeleportPosition()
        local startPivot = character:GetPivot()
        local targetPivot = GetSelectedTeleportCFrame()
        local distance = (startPivot.Position - selectedTeleportPosition).Magnitude
        local tweenTime = math.clamp(distance / 180, 0.5, 5)

        local elapsed = 0
        local finished = false

        local connection
        connection = RunService.Heartbeat:Connect(function(dt)
            if finished then
                return
            end

            local currentCharacter, currentHRP, currentHumanoid = GetCharacter()

            if currentCharacter ~= character
                or not currentHRP
                or not currentHumanoid
                or currentHumanoid.Health <= 0 then
                finished = true
                return
            end

            elapsed += dt
            local alpha = math.clamp(elapsed / tweenTime, 0, 1)

            local cf = startPivot:Lerp(targetPivot, alpha)

            pcall(function()
                currentCharacter:PivotTo(cf)
                currentHRP.AssemblyLinearVelocity = Vector3.zero
                currentHRP.AssemblyAngularVelocity = Vector3.zero
            end)

            if alpha >= 1 then
                finished = true
            end
        end)

        while not finished do
            task.wait()
        end

        pcall(function()
            connection:Disconnect()
        end)

        character:PivotTo(targetPivot)
        hrp.CFrame = targetPivot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
        humanoid.PlatformStand = true

        State.FreezeActive = true

        State.FreezeHeartbeat = RunService.Heartbeat:Connect(function()
            if not State.FreezeActive then
                return
            end

            local currentCharacter, currentHRP, currentHumanoid = GetCharacter()

            if currentCharacter ~= character
                or not currentHRP
                or not currentHumanoid
                or currentHumanoid.Health <= 0 then
                return
            end

            pcall(function()
                currentCharacter:PivotTo(targetPivot)
                currentHRP.AssemblyLinearVelocity = Vector3.zero
                currentHRP.AssemblyAngularVelocity = Vector3.zero
                currentHumanoid.WalkSpeed = 0
                currentHumanoid.JumpPower = 0
                currentHumanoid.AutoRotate = false
                currentHumanoid.PlatformStand = true
            end)
        end)

        State.NoclipActive = true
    end)

    if not ok then
        DisableNoclip()
        State.FreezeActive = false
        State.FreezeSnapshot = nil
        warn("[Miko Hub] Tween/Freeze error:", err)
        return false
    end

    print(string.format(
        "[Miko Hub] MODEL TWEEN + NOCLIP -> FREEZE at %.3f, %.3f, %.3f",
        selectedTeleportPosition.X,
        selectedTeleportPosition.Y,
        selectedTeleportPosition.Z
    ))

    print("[Miko Hub] TP target:", SelectedTransformTarget)
    return true
end

