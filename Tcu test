    tpBtn.Text = "TP"
    tpBtn.TextColor3 = Color3.new(1, 1, 1)
    tpBtn.TextSize = 10
    tpBtn.Font = Enum.Font.GothamBold
    tpBtn.Parent = item
    Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 5)

    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.fromOffset(50, 22)
    delBtn.Position = UDim2.new(1, -54, 0.5, -11)
    delBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 60)
    delBtn.BorderSizePixel = 0
    delBtn.Text = "Delete"
    delBtn.TextColor3 = Color3.new(1, 1, 1)
    delBtn.TextSize = 10
    delBtn.Font = Enum.Font.GothamBold
    delBtn.Parent = item
    Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 5)

    tpBtn.MouseButton1Click:Connect(function()
        local _, hrp, _ = GetCharacter()
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = posData.cframe
        end
    end)

    delBtn.MouseButton1Click:Connect(function()
        for index, p in ipairs(savedPositions) do
            if p.id == posData.id then
                table.remove(savedPositions, index)
                break
            end
        end
        if #savedPositions == 0 then
            positionCounter = 0
        end
        item:Destroy()
    end)
