    nameLabel.Position = UDim2.fromOffset(10, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = posData.name
    nameLabel.TextColor3 = Color3.fromRGB(255, 220, 180)
    nameLabel.TextSize = 10
