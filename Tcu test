local function ScheduleReset()
    local seconds = math.random(ResetMin, ResetMax)
    State.ResetDeadline = os.clock() + seconds
    print("[Miko Hub] Reset scheduled in", math.floor(seconds / 60), "minutes")
end

local function ResetCharacter()
    if State.Resetting then
        return
    end

    local _, _, humanoid = GetCharacter()

    if not humanoid or humanoid.Health <= 0 then
        State.ResetDeadline = nil
        return
    end

    State.Resetting = true
    print("[Miko Hub] Resetting while alive")

    Unfreeze()
    task.wait(0.4)

    pcall(function()
        humanoid.Health = 0
    end)

    State.ResetDeadline = nil
    task.wait(2)

    State.Resetting = false
end

