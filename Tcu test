        hl.Adornee = model
        hl.Parent = model
    end

    local textGui = hrp:FindFirstChild("Miko_ESP_Text")
    if not textGui then
        textGui = Instance.new("BillboardGui")
        textGui.Name = "Miko_ESP_Text"
        textGui.Adornee = hrp
        textGui.Size = UDim2.new(0, 200, 0, 50)
        textGui.StudsOffset = Vector3.new(0, 3.5, 0)
        textGui.AlwaysOnTop = true

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "InfoLabel"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 12
        textLabel.Font = Enum.Font.GothamBold
        textLabel.RichText = true
        textLabel.Parent = textGui

        textGui.Parent = hrp
    end

    local label = textGui:FindFirstChild("InfoLabel")
    if label then
        local hp = math.floor(humanoid.Health)
        local maxHp = math.floor(humanoid.MaxHealth)
        label.Text = string.format("%s\n<font color=\"#00FF88\">HP: %d / %d</font>", model.Name, hp, maxHp)
    end
end

