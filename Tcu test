local AFK_KEYWORDS = {
    "afk", "check", "verify", "verification", "captcha", 
    "idle", "are you there", "anti", "bot", "confirm"
}

local function isAfkGui(gui)
    if not gui:IsA("ScreenGui") or not gui.Enabled then return false end
    
    local guiName = gui.Name:lower()
    for _, kw in ipairs(AFK_KEYWORDS) do
        if guiName:find(kw) then
            return true
        end
    end
    
    for _, textLabel in ipairs(gui:GetDescendants()) do
        if (textLabel:IsA("TextLabel") or textLabel:IsA("TextButton")) and textLabel.Visible then
            local txt = textLabel.Text:lower()
            for _, kw in ipairs(AFK_KEYWORDS) do
                if txt:find(kw) then
                    return true
                end
            end
        end
    end
    
    return false
end

local function processAfkCheck()
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if isAfkGui(gui) then
            print("[Miko Hub | Anti-AFK] Anti-AFK popup detected! Searching for Green Button...")
            
            for _, element in ipairs(gui:GetDescendants()) do
                if (element:IsA("TextButton") or element:IsA("ImageButton")) and element.Visible then
                    local bg = element.BackgroundColor3
                    local text = element:IsA("TextButton") and element.Text:lower() or ""
                    
                    local isGreenColor = (bg.G > 0.5 and bg.R < 0.4 and bg.B < 0.4) or (bg.G > bg.R + 0.3)
                    local isGreenText = text:find("green") or text:find("xanh") or text:find("pass") or text:find("safe")
                    local isRedColor = (bg.R > 0.5 and bg.G < 0.4)
                    
                    if (isGreenColor or isGreenText) and not isRedColor then
                        pcall(function()
                            print("[Miko Hub | Anti-AFK] Clicked Green Button safely!")
                            firesignal(element.MouseButton1Click)
                            firesignal(element.Activated)
                        end)
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function processAfkPart(isAfkActive)
    if not isAfkActive then return end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part:FindFirstChildOfClass("TouchTransmitter") then
            local color = part.Color
            local brickColor = part.BrickColor.Name:lower()
            local isGreenPart = (color.G > 0.5 and color.R < 0.4) or brickColor:find("green") or brickColor:find("lime")
            
            if isGreenPart then
                pcall(function()
                    if firetouchinterest then
                        firetouchinterest(hrp, part, 0)
                        task.wait(0.05)
                        firetouchinterest(hrp, part, 1)
                    end
                end)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        if AutoAntiAFK then
            pcall(function()
                local afkFound = processAfkCheck()
                if afkFound then
