                repeat task.wait() until game:IsLoaded()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/mikothehell/Miko-/refs/heads/main/Tcu%20sv%20hop%201?t=" .. tostring(os.time())))()
            ]])
        end)
