-- 3. Auto Farm Item Loop
task.spawn(function()
    task.wait(3)
    local emptyCheckCounter = 0

    while true do
        task.wait(ScanDelay)
        if AutoFarmEnabled and not isHopping then
            local char = LocalPlayer.Character
            local root = getRootPart()
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hum and hum.Health > 0 and root then
                local items = getMapItems()
                
                if #items > 0 then
                    emptyCheckCounter = 0
                    local pickedAny = false

                    for _, itemData in ipairs(items) do
                        if not AutoFarmEnabled or isHopping then break end
                        if hum.Health <= 0 then break end

                        local target = itemData.Target
                        if target and target.Parent then
                            local targetCFrame = nil
                            if itemData.Part then
                                targetCFrame = itemData.Part.CFrame
                            elseif target:IsA("BasePart") then
                                targetCFrame = target.CFrame
                            elseif target:IsA("Model") or target:IsA("Tool") then
                                targetCFrame = target:GetPivot()
                            end

                            if targetCFrame then
                                pcall(function()
                                    root.Anchored = false
                                    root.CFrame = targetCFrame * CFrame.new(0, 0.5, 0)
                                    stopVelocity(root)
                                    task.wait(0.05)

                                    for i = 1, 2 do
                                        if not target or not target.Parent or hum.Health <= 0 then break end
                                        triggerPickup(char, itemData)
                                        task.wait(0.03)
                                    end

                                    pickedAny = true
                                    task.wait(PickupDelay)
                                end)
                            end
                        end
                    end

                    local remainingItems = getMapItems()
                    if (#remainingItems == 0 or not pickedAny) and AutoServerHopItem then
                        HopServer("Đã thu thập xong Item! Đang chuyển Server...")
                    end
                else
                    emptyCheckCounter = emptyCheckCounter + 1
                    if AutoServerHopItem and emptyCheckCounter >= 2 then
                        HopServer("Không có Item trên Map! Đang đổi Server...")
                    end
                end
            end
        end
    end
end)
