-- Function to get character's HumanoidRootPart safely
local function getRootPart()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return char.HumanoidRootPart
        end
    end
    return nil
end

-- Reset and auto update position on character respawn
LocalPlayer.CharacterAdded:Connect(function()
    savedPosition = nil
    task.wait(1.5)
    local root = getRootPart()
    if root and AutoFarmEnabled then
        savedPosition = root.CFrame
    end
end)

-- Stop movement velocity
local function stopVelocity(root)
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

-- Check if object belongs to any real player
local function isPlayerCharacter(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        local pChar = p.Character
        if pChar and (obj == pChar or obj:IsDescendantOf(pChar)) then
            return true
        end
    end
    return false
end

-- Filter valid collectible items
local function isValidItem(obj, prompt)
    if not obj or not obj.Parent then return false end

    -- 1. Exclude player characters
    if isPlayerCharacter(obj) then return false end

    -- 2. Exclude Seats & Vehicles
    if obj:IsA("Seat") or obj:IsA("VehicleSeat") or obj:FindFirstChildOfClass("Seat") or obj:FindFirstChildOfClass("VehicleSeat") then
        return false
    end

    -- 3. Exclude active NPCs / Enemies / Titans (Must have Humanoid AND not be a dropped Tool)
    local model = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
    if model and not model:IsA("Tool") then
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum then
            return false
        end
    end

    -- 4. Exclude unwanted prompts (revive, shop, vehicle, etc.)
    if prompt then
        local actionText = string.lower(prompt.ActionText or "")
        local objectText = string.lower(prompt.ObjectText or "")
        local badWords = {"revive", "cứu", "help", "heal", "carry", "rescue", "drive", "ride", "enter", "vehicle", "shop", "buy", "talk"}
        
        for _, badWord in ipairs(badWords) do
            if string.find(actionText, badWord) or string.find(objectText, badWord) then
                return false
            end
        end
    end

    return true
end

-- Scan map for all pickup items
local function getMapItems()
    local items = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        -- ProximityPrompts
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and isValidItem(parent, obj) then
                table.insert(items, { Type = "Prompt", Target = parent, Prompt = obj })
            end
        -- TouchTransmitters (Direct Touch Items / Drops)
        elseif obj:IsA("TouchTransmitter") then
            local part = obj.Parent
            if part and part:IsA("BasePart") and isValidItem(part, nil) then
                table.insert(items, { Type = "Touch", Target = part, Part = part })
            end
        -- Dropped Tools
        elseif obj:IsA("Tool") and obj.Parent == workspace then
            if isValidItem(obj, nil) then
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    table.insert(items, { Type = "Tool", Target = obj, Part = handle })
                end
            end
        end
    end

    return items
end

-- Trigger pickup on target
local function triggerPickup(root, itemData)
    if not root or not itemData or not itemData.Target or not itemData.Target.Parent then return end

    -- 1. Trigger ProximityPrompt
    if itemData.Prompt then
        local prompt = itemData.Prompt
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
            fireproximityprompt(prompt, 1)
        end
    end

    -- 2. Trigger TouchInterest
    local part = itemData.Part or (itemData.Target:IsA("BasePart") and itemData.Target or itemData.Target:FindFirstChildWhichIsA("BasePart", true))
    if part and firetouchinterest then
        firetouchinterest(root, part, 0)
        task.wait(0.01)
        firetouchinterest(root, part, 1)
    end
end

