-- Core Helpers
local function getRootPart()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            return root
        end
    end
    return nil
end

LocalPlayer.CharacterAdded:Connect(function()
    savedPosition = nil
end)

local function stopVelocity(root)
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function unanchorRoot(root)
    if root then
        root.Anchored = false
    end
end

local function isValidItem(obj, prompt)
    if not obj or not obj.Parent then return false end

    for _, player in ipairs(Players:GetPlayers()) do
        local pChar = player.Character
        if pChar and (obj == pChar or obj:IsDescendantOf(pChar)) then
            return false
        end
    end

    local ancestorModel = obj:FindFirstAncestorOfClass("Model") or obj
    if ancestorModel then
        if ancestorModel:FindFirstChildOfClass("Humanoid") or ancestorModel:FindFirstChildOfClass("AnimationController") then
            return false
        end
    end
    if obj:FindFirstChildOfClass("Humanoid") or obj:FindFirstChildOfClass("AnimationController") then
        return false
    end

    if obj:IsA("Seat") or obj:IsA("VehicleSeat") or obj:FindFirstChildOfClass("Seat") or obj:FindFirstChildOfClass("VehicleSeat") then
        return false
    end

    if obj:IsA("BasePart") then
        local sz = obj.Size
        if sz.X > 25 or sz.Y > 25 or sz.Z > 25 then
            return false
        end
    end

    local parentName = string.lower(obj.Parent.Name)
    if parentName == "map" or parentName == "enemies" or parentName == "npcs" or parentName == "bosses" then
        return false
    end

    if prompt then
        local actionText = string.lower(prompt.ActionText or "")
        local objectText = string.lower(prompt.ObjectText or "")
        local badWords = {"revive", "cứu", "help", "heal", "carry", "rescue", "drive", "ride", "enter", "vehicle", "shop", "buy", "talk"}
        
        for _, badWord in ipairs(badWords) do
            if string.find(actionText, badWord) or string.find(objectText, badWord) then
                return false
            end
        end
    end

    return true
end

local function getMapItems()
    local items = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and isValidItem(parent, obj) and not table.find(items, parent) then
                table.insert(items, parent)
            end
        elseif obj:IsA("TouchTransmitter") then
            local parent = obj.Parent
            if parent and isValidItem(parent, nil) and not table.find(items, parent) then
                table.insert(items, parent)
            end
        elseif obj:IsA("Tool") and obj.Parent == workspace then
            if isValidItem(obj, nil) and not table.find(items, obj) then
                table.insert(items, obj)
            end
        end
    end
    return items
end

local function forcePickupItem(root, item)
    if not item or not item.Parent or not root then return end

    local prompt = item:FindFirstChildOfClass("ProximityPrompt") 
                or item:FindFirstChildWhichIsA("ProximityPrompt", true)
    
    if prompt then
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
            fireproximityprompt(prompt, 1)
        end
    end

    local targetPart = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
    if targetPart and firetouchinterest then
        firetouchinterest(root, targetPart, 0)
        task.wait(0.01)
        firetouchinterest(root, targetPart, 1)

        local char = LocalPlayer.Character
        if char then
            local leg = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
            if leg then
                firetouchinterest(leg, targetPart, 0)
                firetouchinterest(leg, targetPart, 1)
            end
        end
    end
end

-- GUI Elements
MainTab:Toggle({
    Title = "Auto Farm Item",
    Desc = "Automatically teleport and pick up all items on the map",
    Value = false,
    Callback = function(state)
        AutoFarmEnabled = state
        local root = getRootPart()
        if state then
