-- Background Threads
task.spawn(function()
    while true do
        if AutoSpamEEnabled or InstantHoldEnabled then
            for _, prompt in ipairs(workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    prompt.HoldDuration = 0
                end
            end
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    while true do
        if AutoSpamEEnabled then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.01)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
        task.wait(SpamSpeed)
    end
end)

task.spawn(function()
    while true do
        task.wait(ScanDelay)
        if AutoFarmEnabled then
            local root = getRootPart()
            if root then
                local items = getMapItems()
                if #items > 0 then
                    for _, item in ipairs(items) do
                        if not AutoFarmEnabled then break end
                        if item and item.Parent and isValidItem(item, nil) then
                            local targetCFrame = item:IsA("BasePart") and item.CFrame or item:GetPivot()
                            if targetCFrame then
                                pcall(function()
                                    root.CFrame = targetCFrame
                                    stopVelocity(root)
                                    forcePickupItem(root, item)
                                    root.Anchored = true
                                    task.wait(0.05)

                                    local retryCount = 0
                                    repeat
                                        if not item or not item.Parent then break end
                                        forcePickupItem(root, item)
                                        retryCount = retryCount + 1
                                        task.wait(0.05)
                                    until not item or not item.Parent or retryCount >= 3

                                    task.wait(PickupDelay)
                                end)
                                unanchorRoot(root)
                            end
                        end
                    end
                    if root and savedPosition and ReturnToOldPos and AutoFarmEnabled then
                        unanchorRoot(root)
                        root.CFrame = savedPosition
                        stopVelocity(root)
                    end
                elseif root and savedPosition and ReturnToOldPos then
                    unanchorRoot(root)
                    root.CFrame = savedPosition
                    stopVelocity(root)
                end
            end
        end
    end
end)
