-- ----------------------------------------------------
-- AUTO FARM BACKGROUND LOOP (WITH FIXED RETURN LOGIC)
-- ----------------------------------------------------
task.spawn(function()
    while true do
        task.wait(ScanDelay)

        if AutoFarmEnabled then
            local root = getRootPart()

            if root then
                -- Ensure saved position is recorded BEFORE any teleport occurs
                if ReturnToOldPos and not savedPosition then
                    savedPosition = root.CFrame
                end

                local items = getMapItems()

                if #items > 0 then
                    for _, itemData in ipairs(items) do
                        if not AutoFarmEnabled then break end

                        local target = itemData.Target
                        if target and target.Parent then
                            local targetCFrame = nil

                            if itemData.Part then
                                targetCFrame = itemData.Part.CFrame
                            elseif target:IsA("BasePart") then
                                targetCFrame = target.CFrame
                            elseif target:IsA("Model") or target:IsA("Tool") then
                                targetCFrame = target:GetPivot()
                            end

                            if targetCFrame then
                                pcall(function()
                                    root.Anchored = false
                                    root.CFrame = targetCFrame
                                    stopVelocity(root)

                                    -- Initial trigger
                                    triggerPickup(root, itemData)
                                    task.wait(0.05)

                                    -- Retry trigger
                                    if target and target.Parent then
                                        triggerPickup(root, itemData)
                                    end

                                    task.wait(PickupDelay)
                                end)
                            end
                        end
                    end

                    -- Return to home position after loop ends
                    if root and savedPosition and ReturnToOldPos and AutoFarmEnabled then
                        root.Anchored = false
                        root.CFrame = savedPosition
                        stopVelocity(root)
                    end
                else
                    -- No items found: Return to saved position if enabled
                    if root and savedPosition and ReturnToOldPos then
                        root.Anchored = false
                        root.CFrame = savedPosition
                        stopVelocity(root)
                    end
                end
            end
        end
    end
end)
