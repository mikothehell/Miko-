MainTab:Toggle({
    Title = "Auto Farm Item",
    Desc = "Automatically teleport and pick up all items on the map",
    Value = false,
    Callback = function(state)
        AutoFarmEnabled = state
        local root = getRootPart()

        if state then
            -- Save current standing position BEFORE farm starts teleporting
            if root and not savedPosition then
                savedPosition = root.CFrame
            end
        else
            -- Instantly teleport back to old position when Auto Farm is turned OFF
            if ReturnToOldPos and savedPosition and root then
                root.Anchored = false
                root.CFrame = savedPosition
                stopVelocity(root)
            end
            savedPosition = nil -- Reset for next session
            if root then root.Anchored = false end
        end

        WindUI:Notify({
            Title = "Auto Farm",
            Content = state and "Auto Farm Enabled!" or "Auto Farm Disabled.",
            Duration = 2,
        })
    end
})

