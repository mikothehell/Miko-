                local myChar = LocalPlayer.Character
                local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                
                if myHum then
                    if dodgeWhenAttacked and myHum.Health < lastMyHealth and (tick() - lastDodgeTime > dodgeCooldown) then
