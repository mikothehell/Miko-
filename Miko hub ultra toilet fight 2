-- FIXED HITBOX LOGIC (Hỗ trợ Toilet lớn/boss không bị chìm xuống đất)
local function ApplyHitbox(v)
    if v:IsA("Model") and IsEnemy(v) then
        -- Mở rộng cả HumanoidRootPart và Head để bắt trọn những con Toilet lớn
        local partsToExpand = {v:FindFirstChild("HumanoidRootPart"), v:FindFirstChild("Head")}
        for _, part in ipairs(partsToExpand) do
            if part and part:IsA("BasePart") then
                if part.Size ~= Vector3.new(hitboxSize, hitboxSize, hitboxSize) then
                    part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                end
                if not part:GetAttribute("HitboxResized") then
                    part:SetAttribute("HitboxResized", true)
                    part.Transparency = 0.6
                    part.BrickColor = BrickColor.new("Really blue")
                    part.Material = Enum.Material.Neon
                    part.CanCollide = false
                    part.CanTouch = false
                end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if expandHitbox then
            pcall(function()
                for _, v in ipairs(Workspace:GetChildren()) do
                    ApplyHitbox(v)
                    if v:IsA("Folder") then
                        for _, child in ipairs(v:GetChildren()) do
                            ApplyHitbox(child)
                        end
                    end
                end
            end)
        end
    end
end)

