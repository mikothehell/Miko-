-- Character anchor function
local function SetCharacterAnchor(anchor)
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.Anchored = anchor
        end
    end
end

-- 1. Toggle Freecam Status
local function ToggleFreecam()
    CamActive = not CamActive
    if CamActive then
        StatusBtn.Text = "STATUS: ON"
        StatusBtn.BackgroundColor3 = Color3.fromRGB(20, 75, 45)
        StatusBtn.TextColor3 = Color3.fromRGB(100, 255, 160)
        StatusBtn:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(40, 140, 80)
        
        SavedCameraType = Camera.CameraType
        SavedSubject = Camera.CameraSubject
        CamCFrame = Camera.CFrame
        
        local _, y, z = Camera.CFrame:ToOrientation()
        CameraRotationX = y
        CameraRotationY = z
        
        Camera.CameraType = Enum.CameraType.Scriptable
        SetCharacterAnchor(true)
    else
        StatusBtn.Text = "STATUS: OFF"
        StatusBtn.BackgroundColor3 = Color3.fromRGB(28, 32, 42)
        StatusBtn.TextColor3 = Color3.fromRGB(230, 235, 245)
        StatusBtn:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(45, 50, 65)
        
        Camera.CameraType = SavedCameraType
        Camera.CameraSubject = SavedSubject
        SetCharacterAnchor(false)
    end
end

StatusBtn.MouseButton1Click:Connect(ToggleFreecam)

-- 2. Speed Cycle
local Speeds = {1, 2, 5, 10, 20, 0.5}
local currentSpeedIndex = 1
SpeedBtn.MouseButton1Click:Connect(function()
    currentSpeedIndex = currentSpeedIndex + 1
    if currentSpeedIndex > #Speeds then currentSpeedIndex = 1 end
    CamSpeed = Speeds[currentSpeedIndex]
    SpeedBtn.Text = "SPEED: " .. CamSpeed .. "x"
end)

-- 3. FOV Slider Control
FOVSlider.MouseButton1Click:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    local relativeX = mousePos.X - FOVSlider.AbsolutePosition.X
    local percentage = math.clamp(relativeX / FOVSlider.AbsoluteSize.X, 0, 1)
    
    CamFOV = math.floor(30 + (percentage * 90))
    FOVProgress.Size = UDim2.new(percentage, 0, 1, 0)
    FOVLabel.Text = "FOV: " .. CamFOV
    Camera.FieldOfView = CamFOV
end)

-- 4. Teleport Character to Freecam Position
TeleportBtn.MouseButton1Click:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.Anchored = false
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(Camera.CFrame.Position)
        if CamActive then LocalPlayer.Character.HumanoidRootPart.Anchored = true end
    end
end)

-- 5. Minimize / Restore Menu
local IsHidden = false
local function ToggleMenuVisibility()
    if IsHidden then
        MainFrame:TweenSize(UDim2.new(0, 200, 0, 280), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.25, true)
        HideBtn.Text = "HIDE"
        Content.Visible = true
        CreditLabel.Visible = true
    else
        MainFrame:TweenSize(UDim2.new(0, 200, 0, 40), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.25, true)
        HideBtn.Text = "SHOW"
        Content.Visible = false
        CreditLabel.Visible = false
    end
    IsHidden = not IsHidden
end

HideBtn.MouseButton1Click:Connect(ToggleMenuVisibility)
RedDot.MouseButton1Click:Connect(ToggleMenuVisibility)

-- 6. Screen Drag / Touch Swipe for Camera Rotation
UserInputService.InputChanged:Connect(function(input)
    if not CamActive then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        local sensitivity = 0.005
        CameraRotationX = CameraRotationX - input.Delta.X * sensitivity
        CameraRotationY = math.clamp(CameraRotationY - input.Delta.Y * sensitivity, -math.rad(80), math.rad(80))
    end
end)

-- 7. RenderStepped Loop: Movement Vector Handling
RunService.RenderStepped:Connect(function(dt)
    if CamActive then
        Camera.FieldOfView = CamFOV
        
        local finalRotation = CFrame.Angles(0, CameraRotationX, 0) * CFrame.Angles(CameraRotationY, 0, 0)
        Camera.CFrame = CFrame.new(CamCFrame.Position) * finalRotation
        
        local moveDirection = Vector3.new(0, 0, 0)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            moveDirection = LocalPlayer.Character.Humanoid.MoveDirection
        end
        
        if moveDirection.Magnitude > 0 then
            local forwardVector = Camera.CFrame.LookVector
            local rightVector = Camera.CFrame.RightVector
            
            local camActiveCFrame = Camera.CFrame
            local forwardInput = moveDirection:Dot(Vector3.new(camActiveCFrame.LookVector.X, 0, camActiveCFrame.LookVector.Z).Unit)
            local sideInput = moveDirection:Dot(Vector3.new(camActiveCFrame.RightVector.X, 0, camActiveCFrame.RightVector.Z).Unit)
            
            local flyVector = (forwardVector * forwardInput) + (rightVector * sideInput)
            
            if flyVector.Magnitude > 0 then
                flyVector = flyVector.Unit
                CamCFrame = CFrame.new(CamCFrame.Position + (flyVector * (CamSpeed * 60 * dt)))
            end
        end
        
        Camera.CFrame = CFrame.new(CamCFrame.Position) * finalRotation
    end
end)
