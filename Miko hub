-- AUTO FARM LOGIC
-- =================================================== 
task.spawn(function() 
    while task.wait(0.12) do 
        if autoFarm and not isCollectingLoot then 
            pcall(function() 
                local myChar = LocalPlayer.Character
                local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                
                -- Chỉ né khi BẬT nút Dodge When Attacked và BỊ MẤT MÁU
                if myHum then
                    if dodgeWhenAttacked and myHum.Health < lastMyHealth then
                        if farmPosition == "Above" then
                            farmPosition = "Underground"
                        elseif farmPosition == "Underground" then
                            farmPosition = "Behind"
                        else
                            farmPosition = "Above"
                        end
                    end
                    lastMyHealth = myHum.Health
                end

                local isTargetAlive = currentTarget and currentTarget.Parent 
                    and currentTarget.Parent:FindFirstChildOfClass("Humanoid") 
                    and currentTarget.Parent:FindFirstChildOfClass("Humanoid").Health > 0 
                
                if not isTargetAlive then 
                    currentTarget = GetNearestEnemy() 
                end 
            end) 
        end 
    end 
end) 

